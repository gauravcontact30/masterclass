# Supabase (required) — also provides authentication (email + password)
# Project: masterclassbuddy_db
# Never commit real keys here — this file is tracked in git. Copy it to
# .env.local (which is ignored) and fill the values there.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# Server-only. Bypasses Row Level Security entirely; treat it as a root password.
SUPABASE_SERVICE_ROLE_KEY=xxx
# Required: the sign-in/sign-up flow and every session check use this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# Anthropic (required for document generation)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# Document rendering worker (required to generate PDF/PPTX).
# Both fall back to probing the usual install locations when left blank — on
# Windows that is Chrome/Edge plus C:/Windows/Fonts/Nirmala.ttf. Set them only
# to override. The font must cover Devanagari for Hindi guides to render.
CHROMIUM_EXECUTABLE_PATH=
DOCUMENT_FONT_PATH=
# Shared secret the internal worker route checks before processing the queue.
WORKER_SECRET=

# Razorpay billing (optional — omit BILLING_ENABLED to run with billing disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
BILLING_ENABLED=false
# Set to "true" only once you intentionally point RAZORPAY_KEY_ID at a rzp_live_ key.
ALLOW_LIVE_BILLING=false
# Optional price overrides (INR); defaults are 299 / 2999 / 49 if unset.
PRO_MONTHLY_PRICE_INR=299
PRO_YEARLY_PRICE_INR=2999
DOWNLOAD_CREDIT_PRICE_INR=49

# Generation quotas (optional; defaults are 3 / 50 if unset)
FREE_MONTHLY_GENERATIONS=3
PRO_MONTHLY_GENERATIONS=50

# Figma / Canva design-system integrations (optional)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_WEBHOOK_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Symmetric key used to encrypt stored OAuth credentials at rest.
INTEGRATION_ENCRYPTION_KEY=
# Public base URL used to build OAuth redirect/callback URLs.
APP_URL=http://localhost:3000

# Learn in App code playground (optional)
NEXT_PUBLIC_PLAYGROUND_ENABLED=false
