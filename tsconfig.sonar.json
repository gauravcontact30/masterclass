{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts", "app/**/*.tsx",
    "components/**/*.ts", "components/**/*.tsx",
    "lib/**/*.ts", "lib/**/*.tsx",
    "scripts/**/*.ts", "scripts/**/*.mts",
    "__tests__/**/*.ts", "__tests__/**/*.tsx",
    "proxy.ts", "next.config.ts"
  ],
  "exclude": ["node_modules", ".next", ".scannerwork", "artifacts", "coverage"]
}
