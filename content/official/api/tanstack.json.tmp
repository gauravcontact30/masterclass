  "since": "",
  "interview": [
   {
    "question": "What does matchQuery do?",
    "answer": "matchQuery accepts QueryFilters and a Query, then returns true only when the query satisfies every specified filter. Unspecified filters are ignored.",
    "followUp": "How can you inspect a cache for matches? Retrieve all queries from the QueryCache and filter them with matchQuery."
