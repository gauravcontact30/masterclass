  ],
  "checkedAt": "2026-10-15"
 },
 "queryKey": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/query-functions",
  "sourceTitle": "Query Functions",
  "summary": "queryKey is the array identity for TanStack Query data. It determines cache identity, carries request parameters, and is passed to queryFn through QueryFunctionContext.",
  "explanation": "A queryKey is an array that names and parameterizes cached query data. TanStack Query hashes it into a stable identity, uses it to distinguish cache entries, and supplies it to the query function so request variables can be derived consistently.",
  "syntax": "useQuery({ queryKey: ['todos', { status, page }], queryFn: fetchTodoList })",
  "parameters": [
