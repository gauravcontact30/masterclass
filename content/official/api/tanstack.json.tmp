 },
 "MutationCache": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/classes/MutationCache",
  "sourceTitle": "MutationCache | TanStack Query React Docs",
  "summary": "MutationCache stores mutations and is normally accessed through QueryClient. It supports inspecting, filtering, clearing, and subscribing to mutation-cache updates.",
  "explanation": "MutationCache stores mutation instances and is normally managed through QueryClient rather than accessed directly. You can inspect all or filtered mutations, remove everything, or subscribe to notifications about mutations being added, removed, or updated.",
  "syntax": "new MutationCache(config?: MutationCacheConfig): MutationCache",
  "parameters": [
   {
    "name": "config",
    "type": "MutationCacheConfig",
    "description": "Optional configuration used to initialize the cache."
   }
  ],
  "returns": "A MutationCache instance from the constructor; getAll() returns all mutations, find() returns a matching mutation or undefined, findAll() returns matching mutations, and subscribe() returns an unsubscribe function.",
  "example": {
   "title": "Inspect and observe a mutation cache",
   "code": "import { QueryClient } from '@tanstack/query-core'\n\nconst queryClient = new QueryClient()\nconst mutationCache = queryClient.getMutationCache()\n\nconst unsubscribe = mutationCache.subscribe((event) => {\n  console.log(event.type)\n})\n\nconst pending = mutationCache.findAll({ status: 'pending' })\nconsole.log(pending.length)\nunsubscribe()",
   "language": "typescript",
   "explanation": "Obtains the client-owned cache, observes cache notifications, and filters mutations by pending status."
  },
  "useCases": [
   {
    "title": "Monitor cache notifications",
    "scenario": "Observe application-wide mutation activity for logging, metrics, or debugging."
   },
   {
    "title": "Query mutation state",
    "scenario": "Inspect mutations currently waiting to finish or matching a mutation key."
   },
   {
    "title": "Clear mutation storage",
    "scenario": "Remove all stored mutation instances when resetting client state."
   }
  ],
  "related": [
   "QueryClient",
   "Mutation",
   "MutationCacheConfig",
   "MutationFilters",
   "Subscribable"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is MutationCache and how is it normally accessed?",
    "answer": "MutationCache is the storage for mutations and is owned by QueryClient. A client creates a default cache unless one is supplied, and getMutationCache() returns the connected instance.",
    "followUp": "How would you inspect only pending mutations? Call getMutationCache().findAll({ status: 'pending' }); it returns the mutations matching those filters."
   },
   {
    "question": "How do the cache inspection methods differ?",
    "answer": "getAll() returns every mutation currently held by the cache. find() retrieves one matching mutation, while findAll() retrieves all matching mutations.",
    "followUp": "What should code expect when no mutation matches? find() yields undefined, whereas findAll() yields an empty array."
   },
   {
    "question": "How can code observe and reset MutationCache?",
    "answer": "subscribe() registers a listener for cache notifications, including mutations being added, removed, or updated. It returns an unsubscribe function that stops that listener.",
    "followUp": "How can a cache be reset completely? Call clear(), which removes all mutations from the cache."
   }
  ],
  "keyPoints": [
   "It is the cache layer that holds mutation instances.",
   "Subscriptions report recognized cache changes through the inherited Subscribable mechanism.",
   "Relevant notifications include mutation additions, removals, and updates.",
   "The constructor accepts an optional MutationCacheConfig and returns a new MutationCache.",
   "clear() empties the cache completely.",
   "getAll() provides the complete collection of stored mutations.",
   "subscribe() registers a callback for each update the cache reports."
  ],
  "gotchas": [
   "Prefer QueryClient for ordinary mutation-cache interaction; direct access is intended for specialized inspection or cache-level behavior.",
   "Always retain and invoke the function returned by subscribe when the observer is no longer needed."
  ],
  "checkedAt": "2026-10-15"
 },
 "placeholderData": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/placeholder-query-data",
  "sourceTitle": "Placeholder Query Data",
  "summary": "placeholderData lets a query render with temporary data while the real request runs. Unlike initialData, the temporary value is not persisted in the cache and is marked with isPlaceholderData.",
  "explanation": "placeholderData supplies observer-level temporary data so a query can render successfully while its request runs. The temporary value is not written to the cache; the result exposes isPlaceholderData so the UI can distinguish it from fetched data.",
  "syntax": "useQuery({ queryKey, queryFn, placeholderData })",
  "parameters": [
   {
    "name": "placeholderData",
    "type": "TData | ((previousData: TData | undefined, previousQuery: Query) => TData)",
    "description": "A temporary value or function producing temporary query data; it is used while the real data is fetched and is not persisted in the cache."
   }
  ],
  "returns": "A query result containing the temporary data, with isPlaceholderData set to true while that data is displayed; the fetched result replaces it when available.",
  "example": {
   "title": "Render with placeholder data",
   "code": "import { useQuery } from '@tanstack/react-query'\n\nexport function TodoTitle({ id }: { id: number }) {\n  const query = useQuery({\n    queryKey: ['todo', id],\n    queryFn: () => fetch(`/api/todos/${id}`).then((r) => r.json()),\n    placeholderData: { id, title: 'Loading…' },\n  })\n\n  return <h2>{query.data.title}</h2>\n}",
   "language": "tsx",
   "explanation": "The component renders immediately with temporary todo data while the real response is fetched in the background."
  },
  "useCases": [
   {
    "title": "Progressive rendering",
    "scenario": "A list has enough summary fields to render rows before detail requests finish."
   },
   {
    "title": "Lagged pagination",
    "scenario": "A page-number query changes keys and should keep the previous page visible during refetching."
   },
   {
    "title": "Stable UI shape",
    "scenario": "A skeleton or lightweight fake object can provide the shape required by the view immediately."
   }
  ],
  "related": [
   "initialData",
   "isPlaceholderData",
   "keepPreviousData",
   "queryClient",
   "useQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does placeholderData do, and how does it differ from initialData?",
    "answer": "placeholderData makes a query behave as though it already has data while the actual request proceeds. Unlike initialData, the supplied value is not persisted to the cache.",
    "followUp": "How can the UI identify the temporary state? Check the result's isPlaceholderData flag, which is true while placeholder data is being supplied."
   },
   {
    "question": "What query status should you expect when placeholderData is present?",
    "answer": "A query using placeholderData starts in the success state rather than pending because it has displayable data. The real fetch still runs in the background and replaces the temporary result when it completes.",
    "followUp": "Why is this useful for loading states? It allows partial or fake data to render without showing an empty pending view."
   },
   {
    "question": "What can a placeholderData function access?",
    "answer": "placeholderData may be a function. That function can receive data and query metadata from a previous successful query, enabling the prior result to remain visible during a key change.",
    "followUp": "What common pagination pattern follows from this? Return previousData from the placeholder function so old results remain visible until the new page arrives."
   }
  ],
  "keyPoints": [
   "Temporary data affects the displayed query result but is not stored as cached query state.",
   "It is useful when partial or synthetic values can support an immediate, usable render.",
   "Configure placeholderData declaratively on a query when an immediate provisional result is needed.",
   "The query avoids the pending state because placeholder content is available from the start.",
   "The initial result reports success even though the displayed value is only provisional.",
   "A function form supports dynamic placeholders rather than one fixed value.",
   "The function can inspect the previous successful query's data and metadata, supporting smooth transitions between query keys."
  ],
  "gotchas": [
   "Do not treat placeholderData as cached data: it only affects the current query result and does not populate the query cache.",
   "Use isPlaceholderData to avoid treating the temporary value as the completed server response."
  ],
  "checkedAt": "2026-10-15"
 },
 "QueryCache": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/classes/QueryCache",
  "sourceTitle": "QueryCache | TanStack Query React Docs",
  "summary": "QueryCache stores TanStack Query's query data, metadata, and state. It supports creating, finding, clearing, and observing cached queries, but applications normally use QueryClient instead.",
  "explanation": "QueryCache is TanStack Query's storage layer for query data, metadata, and state. It can be constructed with configuration, queried synchronously, cleared, or observed for tracked cache changes, although most application code should use QueryClient instead.",
  "syntax": "new QueryCache(config?: QueryCacheConfig): QueryCache;",
  "parameters": [
   {
    "name": "config",
    "type": "QueryCacheConfig",
    "description": "Optional configuration for cache behavior and callbacks."
   }
  ],
  "returns": "A QueryCache instance; build returns an existing or newly created Query, while subscription methods provide an unsubscribe function.",
  "example": {
   "title": "Create and observe a QueryCache",
   "code": "import { QueryCache } from '@tanstack/query-core'\n\nconst queryCache = new QueryCache({\n  onError: (error, query) => {\n    console.error(query.queryKey, error)\n  },\n})\n\nconst unsubscribe = queryCache.subscribe((event) => {\n  console.log(event.type)\n})\n\nqueryCache.clear()\nunsubscribe()",
   "language": "typescript",
   "explanation": "Creates a cache with an error callback, observes cache events, clears it, and then removes the subscription."
  },
  "useCases": [
   {
    "title": "Inspect existing queries synchronously",
    "scenario": "Cache inspection"
   },
   {
    "title": "Clear all cached queries when resetting application state",
    "scenario": "Cache lifecycle"
   },
   {
    "title": "Observe tracked additions, removals, and updates",
    "scenario": "Instrumentation"
   },
   {
    "title": "Create or retrieve Query instances for framework integrations and plugins",
    "scenario": "Core integrations"
   }
  ],
  "related": [
   "QueryClient",
   "Query",
   "Subscribable",
   "queryClient.getQueryCache()"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is QueryCache responsible for, and how is it normally accessed?",
    "answer": "QueryCache stores the data, metadata, and state for the queries it contains. QueryClient is normally the application-facing interface for working with a specific cache.",
    "followUp": "How can an application observe cache changes? Use subscribe; it reports safe, tracked updates such as queries being added, removed, or updated."
   },
   {
    "question": "How is a QueryCache created and what operations does it provide?",
    "answer": "The constructor accepts an optional QueryCacheConfig object. The cache can then expose operations such as build, find, findAll, clear, and subscribe.",
    "followUp": "What does build do when the requested query is absent? It creates a Query instance and adds it to the cache."
   },
   {
    "question": "What does QueryCache.build do?",
    "answer": "build checks the supplied query options' queryKey or queryHash. It returns the existing matching Query, or creates and stores a new one when no match exists.",
    "followUp": "Why might direct QueryCache access be inappropriate for UI code? QueryClient and framework integrations provide the intended higher-level interaction model."
   }
  ],
  "keyPoints": [
   "It is the core storage mechanism behind TanStack Query's cached queries.",
   "Each contained query contributes its data, metadata, and state to the cache.",
   "Subscriptions provide notifications for tracked cache updates.",
   "Typical subscription events include query creation, removal, and updates.",
   "Construction optionally accepts QueryCacheConfig and returns a QueryCache instance.",
   "build reuses a matching query or creates and caches one when necessary."
  ],
  "gotchas": [
   "Prefer QueryClient for normal application cache operations rather than accessing QueryCache directly.",
   "A subscriber is not notified when query state is mutated outside the cache's tracked mechanisms."
  ],
  "checkedAt": "2026-10-15"
 },
 "QueryClient": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/classes/QueryClient",
  "sourceTitle": "QueryClient | TanStack Query React Docs",
  "summary": "QueryClient is TanStack Query’s imperative interface for interacting with query and mutation caches. It also owns client-level defaults and methods for fetching, reading, updating, and managing cached data.",
  "explanation": "QueryClient is the imperative entry point for TanStack Query's query and mutation caches. It owns those caches, applies configured defaults, and exposes operations for fetching, reading, updating, invalidating, refetching, cancelling, or removing cached queries.",
  "syntax": "new QueryClient(config?: QueryClientConfig)",
  "parameters": [
   {
    "name": "config",
    "type": "QueryClientConfig",
    "description": "Optional configuration containing query and mutation caches plus default options for resources created through the client."
   }
  ],
  "returns": "A QueryClient instance that owns query and mutation caches and exposes cache-management methods.",
  "example": {
   "title": "Fetch and read cached data",
   "code": "import { QueryClient } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: { staleTime: 60_000 },\n  },\n})\n\nawait queryClient.fetchQuery({\n  queryKey: ['todos'],\n  queryFn: async () => {\n    const response = await fetch('/api/todos')\n    if (!response.ok) throw new Error('Request failed')\n    return response.json()\n  },\n})\n\nconst todos = queryClient.getQueryData(['todos'])\nconsole.log(todos)",
   "language": "typescript",
   "explanation": "Creates a client with a default query freshness period, fetches and caches a query, then synchronously reads its cached data."
  },
  "useCases": [
   {
    "title": "Fetch data imperatively",
    "scenario": "A route loader or server-side function needs data before rendering."
   },
   {
    "title": "Prefetch upcoming data",
    "scenario": "A screen is likely to need data shortly, but should not block the current render."
   },
   {
    "title": "Manage cache state",
    "scenario": "An event handler must update or invalidate cached resources after a mutation."
   }
  ],
  "related": [
   "QueryCache",
   "MutationCache",
   "fetchQuery",
   "prefetchQuery",
   "getQueryData",
   "invalidateQueries",
   "getQueryCache"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is the purpose of QueryClient?",
    "answer": "QueryClient provides imperative access to TanStack Query's caches. It owns a QueryCache and MutationCache and stores defaults applied to queries and mutations created through it.",
    "followUp": "How would you avoid an unnecessary network request? Use fetchQuery with a suitable staleTime; it returns cached data while that data is still fresh."
   },
   {
    "question": "When would you use fetchQuery instead of getQueryData?",
    "answer": "fetchQuery asynchronously fetches and caches a query, returning its data or throwing an error. If matching cached data is not stale according to staleTime, it returns that cached value instead of fetching.",
    "followUp": "How does this differ from prefetchQuery? prefetchQuery performs the fetch without requiring the caller to use the resulting data."
   },
   {
    "question": "What does getQueryData do when no cache entry exists?",
    "answer": "getQueryData synchronously reads an existing query's cached data. It only reads the cache and returns undefined when the query is absent.",
    "followUp": "How can several cached queries be inspected together? Use getQueriesData with a query key or query filter to obtain matching entries."
   }
  ],
  "keyPoints": [
   "Use one QueryClient as the imperative coordinator for query and mutation cache operations.",
   "The client owns both cache types, creating default caches when custom ones are not supplied.",
   "Default options configured on the client affect resources created through that client.",
   "fetchQuery combines retrieval and conditional fetching, based on cache freshness.",
   "getQueryCache exposes the underlying query cache associated with the client."
  ],
  "gotchas": [
   "Imperative fetches do not inherit observer retry behavior; configure retry explicitly when using fetchQuery.",
   "getQueryData does not fetch missing data, so callers must handle an undefined result."
  ],
  "checkedAt": "2026-10-15"
 },
 "QueryClientProvider": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/QueryClientProvider",
  "sourceTitle": "QueryClientProvider | TanStack Query React Docs",
  "summary": "QueryClientProvider supplies a QueryClient to a React component tree. It also manages the client's mount and unmount lifecycle.",
  "explanation": "QueryClientProvider places the supplied QueryClient into React context so descendant components can retrieve it with useQueryClient. Mounting and unmounting the provider also mounts or unmounts the client, connecting it to focus and online events.",
  "syntax": "function QueryClientProvider(props: QueryClientProviderProps): Element;",
  "parameters": [
   {
    "name": "client",
    "type": "QueryClient",
    "description": "The QueryClient instance to provide."
   },
   {
    "name": "children",
    "type": "React.ReactNode",
    "description": "The components that get access to the provided QueryClient."
   },
   {
    "name": "context",
    "type": "React.Context<QueryClient | undefined>",
    "description": "A custom React Query context; otherwise the default context is used."
   }
  ],
  "returns": "An Element containing the supplied children, with access to the provided QueryClient through context.",
  "example": {
   "title": "Provide a QueryClient to React components",
   "code": "import { QueryClient, QueryClientProvider } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient()\n\nexport function App() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      <Dashboard />\n    </QueryClientProvider>\n  )\n}\n\nfunction Dashboard() {\n  return <main>Queries can access the client</main>\n}",
   "language": "tsx",
   "explanation": "Creates one client and makes it available to the descendant component tree."
  },
  "useCases": [
   {
    "title": "Make one configured QueryClient available throughout the app.",
    "scenario": "Application bootstrap"
   },
   {
    "title": "Allow descendant components to use query and mutation hooks backed by the supplied client.",
    "scenario": "Query hooks"
   },
   {
    "title": "Let the client observe focus and online events while the provider is mounted.",
    "scenario": "Focus and reconnect behavior"
   }
  ],
  "related": [
   "QueryClient",
   "useQueryClient",
   "QueryClientProviderProps"
  ],
  "since": "",
  "interview": [
   {
    "question": "What problem does QueryClientProvider solve?",
    "answer": "QueryClientProvider supplies a QueryClient to descendant components through context. Those components can then retrieve the client with useQueryClient.",
    "followUp": "How does the provider affect the client's lifecycle? It calls client.mount() when mounted and client.unmount() when removed, enabling focus and online event subscriptions."
   },
   {
    "question": "What are the important QueryClientProvider props?",
    "answer": "The required client prop is the QueryClient instance that the provider exposes. The children receive access to that instance through the provider.",
    "followUp": "What happens if a component is outside the provider? It cannot obtain the provider's QueryClient through the normal context-based useQueryClient mechanism."
   },
   {
    "question": "What is the component's API shape?",
    "answer": "The React signature is function QueryClientProvider(props: QueryClientProviderProps): Element. Its props include a required client and optional children.",
    "followUp": "When might a custom context be relevant? The context prop lets an application use a custom React Query context instead of the default context."
   }
  ],
  "keyPoints": [
   "Use the provider at the application boundary to make a QueryClient available to the component tree.",
   "Its two core inputs are the QueryClient to expose and the descendant content that consumes it.",
   "Descendants wrapped by the provider are the components granted access to the supplied client.",
   "The returned element wraps children so hooks such as useQueryClient can read the client.",
   "Provider lifecycle integration lets the client respond to focus and online status changes."
  ],
  "gotchas": [
   "The provider manages the client's mount lifecycle, so mounting and unmounting it also changes the client's event subscriptions.",
   "Do not start new code with contextSharing; the documentation marks this option as deprecated."
  ],
  "checkedAt": "2026-10-15"
 },
 "queryFn": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/svelte/reference/interfaces/QueryOptions",
  "sourceTitle": "QueryOptions",
  "summary": "queryFn is the data-fetching function for a TanStack Query. It receives QueryFunctionContext and must return defined data or throw; a configured default can provide it when omitted.",
  "explanation": "queryFn is the function TanStack Query invokes to obtain data for a query. It receives QueryFunctionContext, including the query key and cancellation signal, and must resolve usable data or throw an error; it may be omitted when a default query function is configured.",
  "syntax": "(context: QueryFunctionContext<TQueryKey, TPageParam>) => TQueryFnData | Promise<TQueryFnData>",
  "parameters": [
   {
    "name": "context",
    "type": "QueryFunctionContext<TQueryKey, TPageParam>",
    "description": "Context containing the query key, page parameter when applicable, and other query execution context."
   }
  ],
  "returns": "TQueryFnData or Promise<TQueryFnData>; successful results must be defined, while failures should throw.",
  "example": {
   "title": "A query function using QueryFunctionContext",
   "code": "import { useQuery } from '@tanstack/react-query'\n\ntype Todo = { id: number; title: string }\n\nasync function fetchTodos({ signal }: { signal: AbortSignal }): Promise<Todo[]> {\n  const response = await fetch('/api/todos', { signal })\n  if (!response.ok) throw new Error('Request failed')\n  return response.json()\n}\n\nexport function Todos() {\n  const query = useQuery({\n    queryKey: ['todos'],\n    queryFn: fetchTodos,\n  })\n\n  return <pre>{JSON.stringify(query.data ?? [], null, 2)}</pre>\n}",
   "language": "tsx",
   "explanation": "The query function receives a context object, uses its abort signal for the request, and resolves parsed data or throws when the response fails."
  },
  "useCases": [
   {
    "title": "Network data loading",
    "scenario": "Fetch JSON from an HTTP endpoint and return the parsed response."
   },
   {
    "title": "Context-aware requests",
    "scenario": "Use query context values to select the resource or pass cancellation to a request."
   },
   {
    "title": "Default query functions",
    "scenario": "Share a standard fetching implementation through QueryClient defaults."
   }
  ],
  "related": [
   "QueryFunctionContext",
   "QueryOptions",
   "useQuery",
   "QueryClient",
   "setQueryDefaults",
   "setDefaultOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What contract must a queryFn satisfy?",
