{
 "createColumnHelper": {
  "sourceUrl": "https://tanstack.com/table/latest/docs/reference/index/functions/createColumnHelper",
  "sourceTitle": "createColumnHelper | TanStack Table Docs",
  "summary": "Creates a typed helper for authoring TanStack Table column definitions. It improves inference for accessor values, display and group columns, and arrays of nested definitions.",
  "explanation": "Call createColumnHelper with the table feature type and row type to obtain utilities for building strongly inferred column definitions. Its methods create accessor, display, group, and array-wrapping definitions; at runtime, the helper only produces column-definition objects.",
  "syntax": "createColumnHelper<TFeatures, TData>(): ColumnHelper<TFeatures, TData>",
  "parameters": [
   {
    "name": "TFeatures",
    "type": "TFeatures extends TableFeatures",
    "description": "The table feature configuration type, constrained to TableFeatures; commonly supplied as typeof features."
   },
   {
    "name": "TData",
    "type": "TData extends RowData",
    "description": "The row-data type used by the table."
   }
  ],
  "returns": "ColumnHelper<TFeatures, TData>",
  "example": {
   "title": "Create typed column definitions",
   "code": "import { createColumnHelper, tableFeatures } from '@tanstack/react-table'\n\ntype Person = { firstName: string; age: number }\nconst features = tableFeatures({})\nconst helper = createColumnHelper<typeof features, Person>()\n\nconst columns = helper.columns([\n  helper.accessor('firstName', { header: 'First name' }),\n  helper.accessor(row => row.age, { id: 'age', header: 'Age' }),\n  helper.display({ id: 'actions', header: 'Actions' }),\n])\n\nconsole.log(columns)",
   "language": "typescript",
   "explanation": "Creates typed accessor and display column definitions, then wraps the array to preserve individual value types."
  },
  "useCases": [
   {
    "title": "Strongly typed data columns",
    "scenario": "Build columns whose value types follow row-property keys or accessor callbacks."
   },
   {
    "title": "Display-only columns",
    "scenario": "Represent actions, selection controls, or other cells without a row data value."
   },
   {
    "title": "Grouped and nested columns",
    "scenario": "Organize leaf columns into nested headers while retaining precise array types."
   }
  ],
  "related": [
   "ColumnHelper",
   "ColumnDef",
   "tableFeatures",
   "createTableHook",
   "accessor",
   "display",
   "group",
   "columns"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does createColumnHelper return and why use it?",
    "answer": "createColumnHelper<TFeatures, TData>() returns a ColumnHelper<TFeatures, TData>. It provides utilities for authoring column definitions with stronger value inference, especially for accessor values.",
    "followUp": "What happens at runtime? The helper does not add table behavior; it returns column-definition objects."
   },
   {
    "question": "What utilities does the returned helper expose?",
    "answer": "accessor builds data columns from a key or accessor function, display builds non-data columns, and group builds parent columns containing nested columns. The columns method wraps an array so individual value types are preserved.",
    "followUp": "When would columns be especially useful? Use it for nested groups or heterogeneous column arrays where plain array inference loses precision."
   },
   {
    "question": "How should its generic parameters be selected?",
    "answer": "The function takes TFeatures, extending TableFeatures, and TData, extending RowData. In the current API, the feature type normally comes from typeof features, while TData is the row shape.",
    "followUp": "How does the factory differ when using createTableHook? Its returned createAppColumnHelper is already bound to the feature type, so only TData is supplied."
   }
  ],
  "keyPoints": [
   "Use the function to make TypeScript infer column values more precisely than many plain object-literal definitions.",
   "Accessor columns can derive their value type from either a row-property key or a callback.",
   "Use display columns for UI-only content that does not represent a value from each row.",
   "Group columns organize nested child columns under a parent definition.",
   "Wrap column arrays with columns when preserving each member's individual value type matters.",
   "The helper is available through framework adapters as well as the table-core package."
  ],
  "gotchas": [
   "The helper is optional: ordinary ColumnDef objects remain a valid alternative."
  ],
  "checkedAt": "2026-10-15"
 },
 "createRouter": {
  "sourceUrl": "https://tanstack.com/router/latest/docs/api/router/createRouterFunction",
  "sourceTitle": "createRouter function",
  "summary": "Creates a TanStack Router instance from a RouterOptions object. The required route tree and other router-wide settings are supplied through that object.",
  "explanation": "Call createRouter with a RouterOptions object to construct a Router instance. The routeTree option supplies the routes used by the router, while other options configure behavior such as preloading; the resulting instance is passed to a router provider.",
  "syntax": "createRouter(options: RouterOptions): Router",
  "parameters": [
   {
    "name": "options",
    "type": "RouterOptions",
    "description": "Options used to configure the router instance, including the required route tree."
   }
  ],
  "returns": "An instance of the Router.",
  "example": {
   "title": "Create and provide a router",
   "code": "import { createRouter, RouterProvider } from '@tanstack/react-router'\nimport { routeTree } from './routeTree.gen'\n\nconst router = createRouter({\n  routeTree,\n  defaultPreload: 'intent',\n})\n\nexport default function App() {\n  return <RouterProvider router={router} />\n}",
   "language": "tsx",
   "explanation": "Creates a router from the generated route tree and enables intent-based preloading, then supplies that router to the provider."
  },
  "useCases": [
   {
    "title": "Create the application's central router instance",
    "scenario": "Application bootstrap"
   },
   {
    "title": "Provide routing through RouterProvider",
    "scenario": "React integration"
   },
   {
    "title": "Set router-wide behavior such as default preloading",
    "scenario": "Routing configuration"
   },
   {
    "title": "Share consistent router construction across server and client",
    "scenario": "Server-side rendering"
   }
  ],
  "related": [
   "RouterOptions",
   "RouterProvider",
   "routeTree"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does createRouter do?",
    "answer": "createRouter accepts a RouterOptions object and returns a Router instance. The options configure the router, including the route tree it uses.",
    "followUp": "Why is routeTree required? It supplies the routes the router uses to match and render the application."
   },
   {
    "question": "What is the purpose of routeTree?",
    "answer": "The routeTree option is required and identifies the route tree used to configure the router instance. It is typically imported from the generated route-tree module.",
    "followUp": "How would you share router creation between server and client? Put a createRouter wrapper in a shared file and call it from both entry points."
   },
   {
    "question": "How is the returned router used in a React application?",
    "answer": "After creating the instance, pass it to RouterProvider through its router prop. Router-wide behavior can be configured in the createRouter options object.",
    "followUp": "What should an SSR implementation consider? The router should be created consistently in both server and client environments."
   }
  ],
  "keyPoints": [
   "Its single input is a configuration object typed as RouterOptions.",
   "The function constructs and returns a new router rather than modifying an existing one.",
   "RouterOptions provides router-wide configuration.",
   "A React application supplies the created instance to RouterProvider."
  ],
  "gotchas": [
   "Pass the configuration object to createRouter; it expects RouterOptions rather than a route definition or provider component.",
   "The returned router coordinates route matching and navigation, so it should be created as the application's central router instance."
  ],
  "checkedAt": "2026-10-15"
 },
 "dehydrate": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/solid/reference/functions/dehydrate",
  "sourceTitle": "dehydrate",
  "summary": "Converts a QueryClient cache into a serializable DehydratedState for transferring prefetched data, commonly from server to client. It includes successful queries and paused mutations by default, with options for selection and transformation.",
  "explanation": "dehydrate converts a QueryClient cache into a plain, serializable DehydratedState containing selected queries and mutations. By default, successful queries and paused mutations are included; options can change inclusion rules and transform data or errors before the result is passed to hydrate.",
  "syntax": "function dehydrate(client: QueryClient, options?: DehydrateOptions): DehydratedState;",
  "parameters": [
   {
    "name": "client",
    "type": "QueryClient",
    "description": "The QueryClient whose cache is converted to dehydrated state."
   },
   {
    "name": "options",
    "type": "DehydrateOptions",
    "description": "Optional controls for selecting queries and mutations and transforming their data or errors; defaults to an empty options object."
   }
  ],
  "returns": "DehydratedState containing the included dehydrated queries and mutations.",
  "example": {
   "title": "Dehydrate a prefetched query",
   "code": "import { QueryClient, dehydrate } from '@tanstack/query-core'\n\nconst queryClient = new QueryClient()\nawait queryClient.prefetchQuery({\n  queryKey: ['posts'],\n  queryFn: async () => fetch('/api/posts').then((r) => r.json()),\n})\n\nconst dehydratedState = dehydrate(queryClient)\nconsole.log(JSON.stringify(dehydratedState))",
   "language": "typescript",
   "explanation": "Prefetches posts into a query client and converts its cache into a serializable state suitable for transferring to another environment."
  },
  "useCases": [
   {
    "title": "Transfer prefetched queries from server-rendered markup to a browser QueryClient.",
    "scenario": "Server-side rendering"
   },
   {
    "title": "Serialize selected cache entries for storage in a persistent location.",
    "scenario": "State persistence"
   },
   {
    "title": "Choose which queries or mutations to include and transform their data or errors.",
    "scenario": "Custom cache export"
   }
  ],
  "related": [
   "QueryClient",
   "DehydrateOptions",
   "DehydratedState",
   "DehydratedQuery",
   "DehydratedMutation",
   "hydrate",
   "defaultShouldDehydrateQuery",
   "defaultShouldDehydrateMutation"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does dehydrate do?",
    "answer": "dehydrate takes a QueryClient and optional DehydrateOptions, then returns a DehydratedState. The result represents the cache in a plain serializable form for later restoration with hydrate.",
    "followUp": "How are inclusion and transformation policies selected? The call's options take precedence, then the client's dehydrate defaults, then the library defaults for queries and mutations."
   },
   {
    "question": "What does dehydrate include by default?",
    "answer": "The default output contains dehydrated queries that succeeded and dehydrated mutations that are paused. Other entries require configuration through DehydrateOptions or client defaults.",
    "followUp": "Why might a failed query be absent from server-rendered state? Because successful queries are the default query inclusion set, so the query must be explicitly selected if failures should be transferred."
   },
   {
    "question": "How is dehydrate used in server rendering?",
    "answer": "A common flow is to prefetch data into a QueryClient, call dehydrate, serialize or embed the resulting state, and later restore it into a client QueryClient with hydrate. This supports server-rendered markup and client startup with prefetched data.",
    "followUp": "What does the returned state contain? It has mutations and queries collections, whose entries are represented by DehydratedMutation and DehydratedQuery types."
   }
  ],
  "keyPoints": [
   "It captures both query and mutation cache entries from the supplied QueryClient.",
   "The result is intended to be represented as ordinary serializable state.",
   "A primary use is transferring prefetched server data through rendered output.",
   "The produced state is designed to be restored into another QueryClient.",
   "DehydrateOptions controls selection and transformation of cached data and errors."
  ],
  "gotchas": [
   "Mutations are not all exported automatically; the default includes only paused mutations.",
   "Queries that are loading or failed are omitted unless the dehydrate configuration explicitly includes them.",
   "Per-call options inherit from the QueryClient's dehydrate defaults when not supplied."
  ],
  "checkedAt": "2026-10-15"
 },
 "enabled": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/disabling-queries",
  "sourceTitle": "Disabling/Pausing Queries",
  "summary": "The enabled option controls whether a query runs automatically. Set it to false to defer fetching, then use refetch for manual execution when needed.",
  "explanation": "Set enabled to false, or to a callback-like condition through derived state, when a query must wait before automatically fetching. Disabled queries can still be triggered with refetch, while enabled queries participate in normal mounting, background-refetching, and invalidation behavior.",
  "syntax": "useQuery({ queryKey, queryFn, enabled: boolean })",
  "parameters": [
   {
    "name": "enabled",
    "type": "boolean | () => boolean",
    "description": "Boolean or a function returning a boolean that controls whether the query is enabled."
   }
  ],
  "returns": "No standalone return value; useQuery exposes refetch for manual triggering.",
  "example": {
   "title": "Conditionally enable a query",
   "code": "import { useQuery } from '@tanstack/react-query'\n\nexport function Todos({ userId }: { userId?: string }) {\n  const query = useQuery({\n    queryKey: ['todos', userId],\n    queryFn: () => fetch(`/api/todos?userId=${userId}`).then(r => r.json()),\n    enabled: Boolean(userId),\n  })\n\n  return <pre>{JSON.stringify(query.data ?? [], null, 2)}</pre>\n}",
   "language": "tsx",
   "explanation": "The query waits until userId exists, then runs normally."
  },
  "useCases": [
   {
    "title": "Dependent or conditional fetching",
    "scenario": "A query needs an identifier, token, or form input before its first request."
   },
   {
    "title": "Lazy/manual queries",
    "scenario": "A screen should wait for an explicit user action before requesting data."
   },
   {
    "title": "State-gated data loading",
    "scenario": "A request should remain inactive until application state satisfies a condition."
   }
  ],
  "related": [
   "skipToken",
   "useQuery",
   "refetch",
   "invalidateQueries",
   "refetchQueries",
   "Dependent Queries"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does enabled: false do?",
    "answer": "Set enabled to false to prevent automatic execution. The hook can still expose cached data, and refetch can manually trigger the request.",
    "followUp": "How does disabled state differ with cached data? With cached data the query starts successful; without it, it starts pending with an idle fetch status."
   },
   {
    "question": "Which automatic behaviors are suppressed?",
    "answer": "A disabled query does not fetch on mount, does not background-refetch, and ignores relevant invalidateQueries and refetchQueries calls. This makes it useful when fetching should be controlled explicitly.",
    "followUp": "How can a query become lazy rather than permanently disabled? Change the condition used for enabled when the required input becomes available."
   },
   {
    "question": "When should enabled be preferred over skipToken?",
    "answer": "The documentation recommends enabled: false when manual refetching is needed, because refetch works properly there. skipToken is a typesafe alternative for disabling a TypeScript query, but it does not support that refetch behavior.",
    "followUp": "When is skipToken preferable? Use it when conditional disabling should preserve type safety and manual refetch is not required."
   }
  ],
  "keyPoints": [
   "Use enabled: false to stop a query from automatically running.",
   "The enabled condition may be computed dynamically rather than fixed permanently.",
   "A disabled query does not start a request when its component mounts.",
   "Background refetching is paused while enabled resolves to false.",
   "Use the hook's refetch function for an explicit request when automatic execution is disabled.",
   "Changing the enabling condition supports lazy queries that begin after required input is ready."
  ],
  "gotchas": [
   "Do not expect refetch returned by the query hook to work when the query is disabled with skipToken.",
   "A disabled query does not respond to invalidation or refetch calls that would ordinarily cause it to fetch."
  ],
  "checkedAt": "2026-10-15"
 },
 "flexRender": {
  "sourceUrl": "https://tanstack.com/table/latest/docs/framework/react/guide/flex-render",
  "sourceTitle": "FlexRender (React) Guide",
  "summary": "flexRender is TanStack Table’s lower-level helper for rendering a column definition with supplied props or context. Use FlexRender instead for normal table markup when table-aware handling of aggregated and placeholder cells is needed.",
  "explanation": "flexRender is the lower-level TanStack Table helper for turning a renderable column definition into framework output. Provide the definition and its matching context; use the table-aware FlexRender wrapper instead when rendering ordinary headers, cells, or footers so table-specific choices are handled.",
  "syntax": "flexRender(render, props)",
  "parameters": [
   {
    "name": "render",
    "type": "Renderable",
    "description": "The renderable column definition, such as a cell, header, or footer renderer."
   },
   {
    "name": "props",
    "type": "object",
    "description": "The props or table context supplied to the renderable definition."
   }
  ],
  "returns": "Framework-rendered output corresponding to the supplied renderable definition and props.",
  "example": {
   "title": "Render a cell definition",
   "code": "import { flexRender } from '@tanstack/react-table'\n\nconst content = flexRender(\n  cell.column.columnDef.cell,\n  cell.getContext(),\n)",
   "language": "tsx",
   "explanation": "Renders a cell's column definition with the cell's typed context."
  },
  "useCases": [
   {
    "title": "Render a cell definition",
    "scenario": "A custom cell renderer is already available together with its cell context."
   },
   {
    "title": "Render table regions",
    "scenario": "A header or footer definition must be rendered with its corresponding context."
   },
   {
    "title": "Implement custom rendering flow",
    "scenario": "A caller needs low-level control instead of the table-aware wrapper’s cell-selection behavior."
   }
  ],
  "related": [
   "FlexRender",
   "cell.getContext()",
   "cell.getValue()",
   "cell.renderValue()",
   "aggregatedCell"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does flexRender do?",
    "answer": "flexRender accepts a renderable definition and the props or context to give it. In a React table, a typical call is flexRender(cell.column.columnDef.cell, cell.getContext()).",
    "followUp": "When should the wrapper be preferred? Prefer FlexRender for normal table markup because it selects the relevant cell definition and handles grouped-cell and placeholder behavior."
   },
   {
    "question": "When would you use flexRender rather than getValue?",
    "answer": "It supports rendering column-definition content such as headers, cells, and footers when the caller already has the renderable value and its props. It passes the supplied context to renderer components or functions.",
    "followUp": "What should be used when only the accessor value is needed? Use cell.getValue() or cell.renderValue() instead of rendering the column definition."
   },
   {
    "question": "What behavior is intentionally outside flexRender?",
    "answer": "The lower-level helper does not make table-aware decisions. In particular, it does not switch between cell and aggregatedCell or suppress grouping placeholders.",
    "followUp": "How can ordinary table markup obtain those decisions? Pass the cell, header, or footer object to FlexRender, the recommended component wrapper."
   }
  ],
  "keyPoints": [
   "It is the lower-level rendering helper for cases where the renderable value and its context are already available.",
   "Call it with a column definition plus the corresponding table object context.",
   "It can render static React nodes as well as renderer components defined in table columns.",
   "React component types are handled differently from nodes that have already been created.",
   "Choose the rendering helper when you need the complete column-definition context rather than only an accessor value."
  ],
  "gotchas": [
   "Unlike the table-aware FlexRender wrapper, flexRender does not choose an aggregated renderer or hide grouping placeholders.",
   "Do not use flexRender merely to read an accessor result; use getValue or renderValue for that narrower need."
  ],
  "checkedAt": "2026-10-15"
 },
 "gcTime": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useQuery",
  "sourceTitle": "useQuery",
  "summary": "gcTime specifies how long unused or inactive TanStack Query cache data stays in memory before garbage collection. It defaults to five minutes, is Infinity during SSR, and can be set to Infinity to disable collection.",
  "explanation": "gcTime controls how long inactive query data remains in memory after the query has no subscribers. Once that period expires, TanStack Query garbage-collects the data; it does not limit retention while the query is actively used. The longest configured duration applies, Infinity disables collection, and SSR defaults to Infinity.",
  "syntax": "gcTime?: number",
  "parameters": [
   {
    "name": "gcTime",
    "type": "number | undefined",
    "description": "Retention duration, in milliseconds, for unused or inactive query cache data."
   }
  ],
  "returns": "",
  "example": {
   "title": "Configure unused-query retention",
   "code": "import { QueryClient, useQuery } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: { gcTime: 1000 * 60 * 60 * 24 },\n  },\n})\n\nexport function Todos() {\n  const query = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/api/todos').then((r) => r.json()),\n    gcTime: 1000 * 60 * 5,\n  })\n\n  return <pre>{JSON.stringify(query.data)}</pre>\n}",
   "language": "tsx",
   "explanation": "This query keeps unused data for five minutes, while the client default retains other query data for one day."
  },
  "useCases": [
   {
    "title": "Tune inactive-cache retention",
    "scenario": "Retain query results for a controlled period after a component unmounts."
   },
   {
    "title": "Coordinate persistence and garbage collection",
    "scenario": "Keep hydrated or persisted data available long enough for the persistence policy."
   },
   {
    "title": "Disable collection",
    "scenario": "Prevent automatic removal of inactive data in a long-lived client."
   }
  ],
  "related": [
   "staleTime",
   "QueryClient",
   "defaultOptions.queries",
   "persistQueryClient",
   "timeoutManager.setTimeoutProvider"
  ],
  "since": "5.0.0",
  "interview": [
   {
    "question": "What does gcTime control?",
    "answer": "gcTime is the retention period for unused or inactive query data. It begins to matter only after a query is no longer in use; expiration then allows the cached data to be garbage-collected.",
    "followUp": "How does it interact with multiple configurations? The longest specified garbage-collection duration is used."
   },
   {
    "question": "What are the defaults, and how can garbage collection be disabled?",
    "answer": "The default is five minutes in normal operation and Infinity during SSR. Setting gcTime to Infinity disables garbage collection, so inactive data is not automatically removed.",
    "followUp": "What value should be used with persisted queries? Set gcTime to the same value or higher than the persistence maxAge."
   },
   {
    "question": "How does gcTime differ from staleTime?",
    "answer": "gcTime is distinct from staleTime. staleTime determines when data becomes stale, whereas gcTime determines how long unused data remains in memory before collection.",
    "followUp": "What limits unusually long gcTime values? The ordinary timer implementation supports roughly 24 days; timeoutManager.setTimeoutProvider can provide a workaround."
   }
  ],
  "keyPoints": [
   "Set gcTime as a duration in milliseconds for retaining inactive query data.",
   "The countdown starts when the query becomes unused or inactive, not while it has active observers.",
   "Use Infinity when inactive cached data should not be automatically collected.",
   "The standard default is five minutes, while server-side rendering uses Infinity."
  ],
  "gotchas": [
   "A shorter gcTime does not override a longer duration configured elsewhere.",
   "Very large durations exceed the normal JavaScript timer limit unless a custom timeout provider is used."
  ],
  "checkedAt": "2026-10-15"
 },
 "getCoreRowModel": {
  "sourceUrl": "https://tanstack.com/table/latest/docs/reference/static-functions/functions/table_getCoreRowModel",
  "sourceTitle": "table_getCoreRowModel | TanStack Table Docs",
  "summary": "getCoreRowModel provides TanStack Table's unmodified starting row model. It maps the table's original data into rows before other row-model features process them.",
  "explanation": "In the current TanStack Table documentation, getCoreRowModel is the factory used to provide a table's basic row model. The model preserves the original data's one-to-one row mapping before filtering, grouping, sorting, expansion, or pagination are applied.",
  "syntax": "function table_getCoreRowModel<TFeatures, TData>(table): RowModel<TFeatures, TData>;",
  "parameters": [
   {
    "name": "table",
    "type": "Table_Internal<TFeatures, TData>",
    "description": "The internal table instance whose core row model is resolved."
   }
  ],
  "returns": "RowModel<TFeatures, TData>",
  "example": {
   "title": "Enable the core row model",
   "code": "import { createTable } from '@tanstack/table-core'\nimport { getCoreRowModel } from '@tanstack/table-core'\n\nconst table = createTable({\n  data: [{ id: 1, name: 'Ada' }],\n  columns: [{ accessorKey: 'name', header: 'Name' }],\n  getCoreRowModel: getCoreRowModel(),\n})\n\nconst rows = table.getCoreRowModel().rows",
   "language": "typescript",
   "explanation": "Creates a table with the core row-model factory enabled, then reads the unprocessed rows."
  },
  "useCases": [
   {
    "title": "Read source rows",
    "scenario": "Use the initial, unprocessed rows when a table also has filtering, sorting, grouping, expansion, or pagination enabled."
   },
   {
    "title": "Initialize table row processing",
    "scenario": "Configure an adapter-style table that expects a core row-model option."
   },
   {
    "title": "Debug row-model behavior",
    "scenario": "Inspect data before downstream row-model transformations are applied."
   }
  ],
  "related": [
   "RowModel",
   "getFilteredRowModel",
   "getGroupedRowModel",
   "getSortedRowModel"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does getCoreRowModel provide?",
    "answer": "getCoreRowModel supplies the table's unmodified core row model. It represents the original table data before other row-model processing is applied.",
    "followUp": "How does it differ from getRowModel? getRowModel is the final model after enabled processing features, whereas the core model is the unprocessed starting point."
   },
   {
    "question": "How is it configured and what does it contain?",
    "answer": "In the documented adapter-style API, it is passed as getCoreRowModel: getCoreRowModel(). The resulting core model is a basic one-to-one mapping of the data supplied to the table.",
    "followUp": "What should be used to inspect the final displayed rows? Use table.getRowModel(), because later enabled models can transform the core rows."
   },
   {
    "question": "Where does the core row model fit in processing?",
    "answer": "The core model is the first stage in the row-model pipeline. Filtering, grouping, sorting, expansion, and pagination can then process its output when those features are enabled.",
    "followUp": "Why inspect the core model instead of the final model? Use it when you need rows unaffected by those transformations, such as an unfiltered source view."
   }
  ],
  "keyPoints": [
   "The returned model is not filtered, grouped, sorted, expanded, or paginated.",
   "The factory is initialized once for each table rather than recreated for every row-model read.",
   "After creation, the table reuses the factory on subsequent core-model requests."
  ],
  "gotchas": [
   "Do not add this factory when using the v9 tableFeatures API; the core row model is included automatically there."
  ],
  "checkedAt": "2026-10-15"
 },
 "getExpandedRowModel": {
  "sourceUrl": "https://tanstack.com/table/v8/docs/api/features/expanding",
  "sourceTitle": "Expanding APIs | TanStack Table Docs",
  "summary": "getExpandedRowModel enables client-side row expansion in TanStack Table. It returns the expanded row model for use in the table's row-model pipeline.",
  "explanation": "getExpandedRowModel is a factory used in TanStack Table options to enable client-side expansion. The resulting row-model function produces rows after expansion has been applied, using the table's expansion state and sub-row relationships.",
  "syntax": "getExpandedRowModel?: (table: Table<TData>) => () => RowModel<TData>",
  "parameters": [
   {
    "name": "table",
    "type": "Table<TData>",
    "description": "The table instance used by the row-model factory."
   }
  ],
  "returns": "A function returning RowModel<TData>; the resulting row model contains rows after expansion has been applied.",
  "example": {
   "title": "Enable client-side expansion",
   "code": "import { getCoreRowModel, getExpandedRowModel, useReactTable } from '@tanstack/react-table'\n\ntype Person = { name: string; subRows?: Person[] }\n\nconst table = useReactTable<Person>({\n  data: [{ name: 'Ada', subRows: [{ name: 'Grace' }] }],\n  columns: [{ accessorKey: 'name', header: 'Name' }],\n  getCoreRowModel: getCoreRowModel(),\n  getExpandedRowModel: getExpandedRowModel(),\n})\n\nconsole.log(table.getExpandedRowModel().rows.length)",
   "language": "typescript",
   "explanation": "Creates a client-side expanded row model and makes it available through the table instance."
  },
  "useCases": [
   {
    "title": "Client-side hierarchical tables",
    "scenario": "A table stores child records in its row data and needs expandable parent rows."
   },
   {
    "title": "Custom expansion row models",
    "scenario": "A project needs expansion behavior that differs from the package default."
   },
   {
    "title": "Server-side expansion",
    "scenario": "A table displays expansion results produced by an API or external data model."
   }
  ],
  "related": [
   "getCoreRowModel",
   "getPreExpandedRowModel",
   "manualExpanding",
   "RowModel<TData>"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is getExpandedRowModel used for?",
    "answer": "It is a row-model factory configured in the table options. Calling it supplies the function that returns the expanded row model, so client-side expansion can be applied.",
    "followUp": "What happens if it is omitted? The table does not expand rows."
   },
   {
    "question": "What does the expanded row model return?",
    "answer": "The option accepts a factory whose table-aware result returns a RowModel<TData>. The table instance exposes that result as the row model after expansion has been applied.",
    "followUp": "How can server-side expansion change this? Set manualExpanding to true and produce the expanded data in your own model."
   },
   {
    "question": "Can the expanded row-model behavior be customized?",
    "answer": "Use the exported getExpandedRowModel function for the default behavior, or provide a custom implementation. A custom implementation is useful when the default expansion behavior does not match the application's needs.",
    "followUp": "What is the key distinction from manual expansion? Manual expansion bypasses this model rather than customizing its client-side calculation."
   }
  ],
  "keyPoints": [
   "The function supplies the row model that represents the table after expansion.",
   "The documented option is a table-dependent factory returning a RowModel-producing function.",
   "The package provides a default implementation for ordinary client-side expansion.",
   "Applications may replace the default with their own row-model implementation.",
   "The resulting table API exposes rows after expansion processing."
  ],
  "gotchas": [
   "Omitting the option disables table row expansion.",
   "With manual server-side expansion enabled, this client-side row model is bypassed."
  ],
  "checkedAt": "2026-10-15"
 },
 "getFacetedRowModel": {
  "sourceUrl": "https://tanstack.com/table/latest/docs/framework/react/reference/legacy/functions/getFacetedRowModel",
  "sourceTitle": "getFacetedRowModel | TanStack Table React Docs",
  "summary": "getFacetedRowModel is a deprecated legacy compatibility marker for TanStack Table v8 faceting. For current tables, register createFacetedRowModel() in the facetedRowModel feature slot instead.",
  "explanation": "In current TanStack Table, the legacy getFacetedRowModel function is only a compatibility marker for the older useLegacyTable API. New tables register createFacetedRowModel() in the facetedRowModel feature slot, after which a column can expose getFacetedRowModel() for facet calculations.",
  "syntax": "function getFacetedRowModel<TData>(): FacetedRowModelFactory<TData>;",
  "parameters": [
   {
    "name": "TData",
    "type": "RowData",
    "description": "Generic row-data type extending RowData; the legacy function takes no runtime arguments."
   }
  ],
  "returns": "FacetedRowModelFactory<TData>",
  "example": {
   "title": "Use the faceted row model",
   "code": "import { createFacetedRowModel } from '@tanstack/table-core'\n\nconst tableFeatures = {\n  facetedRowModel: createFacetedRowModel(),\n}\n\nconst facetedRows = table.getColumn('status')?.getFacetedRowModel()\nconsole.log(facetedRows?.rows)",
   "language": "typescript",
   "explanation": "Registers the client-side factory, then retrieves the rows eligible for faceting on a column."
  },
  "useCases": [
   {
    "title": "Legacy compatibility",
    "scenario": "Maintaining an older TanStack Table v8 or useLegacyTable integration that still expects the legacy row-model option."
   },
   {
    "title": "Client-side column faceting",
    "scenario": "Building client-side faceted filters in the current table API by registering createFacetedRowModel() and reading a column's faceted model."
   },
   {
    "title": "Custom facet computation",
    "scenario": "Implementing custom facet calculations from rows that satisfy other active filters."
   }
  ],
  "related": [
   "createFacetedRowModel()",
   "column.getFacetedRowModel()",
   "createFacetedUniqueValues()",
   "createFacetedMinMaxValues()",
   "filteredRowModel"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does getFacetedRowModel do?",
    "answer": "The legacy function returns a FacetedRowModelFactory<TData> and acts as a marker that enables the faceted row model. In the current API, new tables should register createFacetedRowModel() through the facetedRowModel feature slot.",
    "followUp": "What happens without filteredRowModel? The faceted model uses pre-filtered rows, so values do not reflect filters applied to other columns."
   },
   {
    "question": "How does column faceting respond to filters?",
    "answer": "A column's faceted row model contains rows that pass the other applicable filters while excluding that column's own filter. This supports facet choices that remain useful while the current column filter is being edited.",
    "followUp": "Which additional factories support common facet outputs? createFacetedUniqueValues() provides unique values and counts, while createFacetedMinMaxValues() supports numeric bounds."
   },
   {
    "question": "How is the current faceted row-model factory registered?",
    "answer": "The current feature slot is facetedRowModel, whose factory receives the table and column ID and returns a function producing a RowModel. Server-side faceting does not require this factory.",
    "followUp": "How would you replace the default behavior? Implement a custom factory with the same table-and-column contract and register it in tableFeatures."
   }
  ],
  "keyPoints": [
   "The legacy function enables faceting rather than directly calculating a row collection.",
   "The resulting model supplies rows used by custom facet calculations.",
   "Current tables must provide the facetedRowModel feature factory for client-side faceting."
  ],
  "gotchas": [
   "The documented function is deprecated for new code; use createFacetedRowModel() with the current table setup.",
   "It does not compute rows itself; it exists to preserve compatibility with the legacy v8 API."
  ],
  "checkedAt": "2026-10-15"
 },
 "getFacetedUniqueValues": {
  "sourceUrl": "https://tanstack.com/table/latest/docs/framework/react/guide/column-faceting",
  "sourceTitle": "Faceting (React) Guide | TanStack Table React Docs",
  "summary": "Returns a Map of unique facet values to their occurrence counts. Use it to build checkbox lists, select menus, autocomplete suggestions, or other faceted controls.",
  "explanation": "This column API reads the faceted row model and returns each distinct facet value alongside its occurrence count. The required faceting factories must be registered in the table configuration; custom getUniqueValues logic can make one row contribute several values or map rendered values into facet buckets.",
  "syntax": "column.getFacetedUniqueValues(): Map<any, number>",
  "parameters": [],
  "returns": "Map<any, number>",
  "example": {
   "title": "Build facet suggestions",
   "code": "const suggestions = Array.from(\n  column.getFacetedUniqueValues().entries()\n)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5000);",
   "language": "typescript",
   "explanation": "Creates a frequency-sorted list of facet values for an autocomplete or select control."
  },
  "useCases": [
   {
    "title": "Checkbox or select filters",
    "scenario": "A filter UI needs to show each available value with its frequency."
   },
   {
    "title": "Autocomplete suggestions",
    "scenario": "A search field should suggest values present in the faceted data."
   },
   {
    "title": "Custom facet buckets",
    "scenario": "Values should be grouped into application-defined categories for filtering."
   }
  ],
  "related": [
   "createFacetedRowModel",
   "createFacetedUniqueValues",
   "getUniqueValues",
   "getFacetedRowModel"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does getFacetedUniqueValues return, and what is it useful for?",
    "answer": "It returns a Map whose keys are facet values and whose values are occurrence counts. The result is intended for controls such as checkboxes, select menus, and autocomplete suggestions.",
    "followUp": "How would you constrain a large suggestion list? Convert the Map entries to an array, sort or rank them, and take only the needed leading values."
   },
   {
    "question": "What configuration is required before using this column API?",
    "answer": "The API depends on faceting configuration. For client-side faceting, the table needs the faceted row model and the factory that computes unique values and counts.",
    "followUp": "What if faceting is server-side? Supply a getFacetedUniqueValues table option that resolves and returns the server-provided Map."
   },
   {
    "question": "How should occurrence counts be interpreted?",
    "answer": "For scalar columns, each row normally contributes one value, so a count also corresponds to a row count. With getUniqueValues, a row can contribute multiple values, and counts then describe occurrences.",
    "followUp": "How can a custom facet bucket differ from the displayed value? Return a bucket key from getUniqueValues while retaining the accessor value for rendering and other table behavior."
   }
  ],
  "keyPoints": [
   "The returned Map associates every facet value with its occurrence count.",
   "Transform the Map into a sorted list when populating autocomplete or select controls.",
   "With ordinary scalar values, each occurrence count normally equals the number of rows containing that value.",
   "The column's getUniqueValues option allows a single row to contribute multiple facet values.",
   "Use custom facet bucket keys without changing the original accessor value used for rendering."
  ],
  "gotchas": [
   "When getUniqueValues returns multiple values for one row, counts represent value occurrences rather than unique-row counts, so their total may exceed the row count.",
   "Ensure each facet value is returned at most once per row when counts must represent rows.",
   "Register the faceted-unique-values row-model factory; otherwise this API cannot provide its unique values and counts."
  ],
  "checkedAt": "2026-10-15"
 },
 "getFilteredRowModel": {
  "sourceUrl": "https://tanstack.com/table/v8/docs/api/features/column-filtering",
  "sourceTitle": "Column Filtering APIs | TanStack Table Docs",
  "summary": "getFilteredRowModel configures the row model used for client-side column filtering. The table instance exposes the resulting filtered rows through the same-named method.",
  "explanation": "The table option accepts a factory callback. Calling the adapter-provided getFilteredRowModel() registers that callback, which computes the table's filtered row model when filtering is needed; the table instance then exposes the resulting model through getFilteredRowModel().",
  "syntax": "getFilteredRowModel?: (table: Table<TData>) => () => RowModel<TData>",
  "parameters": [
   {
    "name": "table",
    "type": "Table<TData>",
    "description": "The table instance supplied to the row-model factory."
   }
  ],
  "returns": "The option returns a callback producing RowModel<TData>; the table instance method returns RowModel<TData> after column filtering.",
  "example": {
   "title": "Enable client-side filtering",
   "code": "import { getCoreRowModel, getFilteredRowModel, useReactTable } from '@tanstack/react-table'\n\nconst table = useReactTable({\n  data: [\n    { name: 'Ada', role: 'Engineer' },\n    { name: 'Linus', role: 'Engineer' },\n  ],\n  columns: [\n    { accessorKey: 'name', header: 'Name' },\n    { accessorKey: 'role', header: 'Role' },\n  ],\n  getCoreRowModel: getCoreRowModel(),\n  getFilteredRowModel: getFilteredRowModel(),\n})\n\nconsole.log(table.getFilteredRowModel().rows.length)",
   "language": "typescript",
   "explanation": "Creates a table with the built-in client-side filtered row-model factory and reads the resulting filtered rows."
  },
  "useCases": [
   {
    "title": "Client-side column filtering",
    "scenario": "A browser-rendered data grid filters loaded rows without sending each filter operation to a server."
   },
