 "QueryObserver": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/classes/QueryObserver",
  "sourceTitle": "QueryObserver | TanStack Query React Docs",
  "summary": "QueryObserver observes one query and produces a QueryObserverResult from its state. It supports framework adapters and direct, framework-independent subscriptions.",
  "explanation": "QueryObserver connects a QueryClient to one query and turns query state into a QueryObserverResult. It recalculates when the query or observer options change, and subscribers receive notifications when the computed result changes. Use getCurrentResult for a snapshot or subscribe for ongoing updates.",
  "syntax": "new QueryObserver<TQueryFnData, TError, TData, TQueryData, TQueryKey>(client: QueryClient, options: QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>): QueryObserver<TQueryFnData, TError, TData, TQueryData, TQueryKey>",
  "parameters": [
   {
    "name": "client",
    "type": "QueryClient",
    "description": "The QueryClient used to access and observe the query cache."
   },
   {
    "name": "options",
    "type": "QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>",
    "description": "Configuration describing the query and result typing."
   }
  ],
  "returns": "A QueryObserver instance that computes results for and notifies subscribers about one observed query.",
  "example": {
   "title": "Observe a query outside a framework",
   "code": "import { QueryClient, QueryObserver } from '@tanstack/query-core'\n\nconst client = new QueryClient()\nconst observer = new QueryObserver(client, {\n  queryKey: ['todos'],\n  queryFn: async () => [{ id: 1, title: 'Learn QueryObserver' }],\n})\n\nconst unsubscribe = observer.subscribe((result) => {\n  if (result.isSuccess) console.log(result.data)\n})\n\nobserver.refetch().finally(() => unsubscribe())",
   "language": "typescript",
   "explanation": "Creates a core observer, subscribes to result changes, triggers a fetch, and removes the subscription afterward."
  },
  "useCases": [
   {
    "title": "Build query hooks",
    "scenario": "A framework adapter needs a reactive query result."
   },
   {
    "title": "Observe queries directly",
    "scenario": "A non-framework service needs cache-backed updates."
   },
   {
    "title": "Switch observed queries",
    "scenario": "A client changes which cached query it tracks."
   }
  ],
  "related": [
   "QueryClient",
   "QueryObserverOptions",
   "QueryObserverResult",
   "InfiniteQueryObserver",
   "useQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What problem does QueryObserver solve?",
    "answer": "QueryObserver watches one query in the QueryCache and computes a QueryObserverResult. It recomputes and notifies subscribers when the query or the observer options change.",
    "followUp": "How would you consume a result without subscribing? Call getCurrentResult(), but remember that it returns only the latest point-in-time result."
   },
   {
    "question": "How is a QueryObserver created?",
    "answer": "Construct it with a QueryClient and QueryObserverOptions. The options describe the query being observed, and the constructor returns a QueryObserver instance.",
    "followUp": "How can the observed query be changed? Update the observer's options with the appropriate inherited option-update mechanism, causing the current query and result to be recalculated."
   },
   {
    "question": "How do you receive updates?",
    "answer": "subscribe() registers a listener for observer-result changes and returns an unsubscribe function. Use getCurrentResult() when a synchronous snapshot is sufficient.",
    "followUp": "Why should a subscriber be removed? Because the returned unsubscribe function stops future notifications when the consumer no longer needs the observer."
   }
  ],
  "keyPoints": [
   "It observes exactly one QueryCache query and exposes a derived QueryObserverResult.",
   "Changes to either the query or observer options trigger result recomputation and possible subscriber notification.",
   "Framework hooks such as useQuery use QueryObserver as their underlying primitive.",
   "The class is also suitable for framework-independent code that observes or switches queries.",
   "getCurrentQuery() identifies the Query currently attached to the observer.",
   "getCurrentResult() returns the latest computed result.",
   "updateResult() recalculates and stores the result using the current query and options."
  ],
  "gotchas": [
   "getCurrentResult() is only a snapshot; use subscribe() when the consumer must react to future updates.",
   "Result recomputation does not necessarily notify listeners: notification occurs when the resulting value changes."
  ],
  "checkedAt": "2026-10-15"
 },
 "queryOptions": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/queryOptions",
  "sourceTitle": "queryOptions | TanStack Query React Docs",
  "summary": "queryOptions builds reusable, type-safe TanStack Query configurations. The returned options work with hooks and imperative QueryClient APIs while carrying query data and error types through the query key.",
  "explanation": "queryOptions packages a query key and its behavior into a reusable, type-aware options object. Its returned value brands the key with the query function's data and error types, allowing the same configuration to work with hooks and imperative QueryClient methods while preserving inference.",
  "syntax": "function queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;",
  "parameters": [
   {
    "name": "options",
    "type": "DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> | UnusedSkipTokenOptions<TQueryFnData, TError, TData, TQueryKey> | UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>",
    "description": "A query options object, including the required queryKey and the query behavior accepted by useQuery."
   }
  ],
  "returns": "The supplied query options augmented with a QueryKeyWithDataTag carrying the query function's data and error types.",
  "example": {
   "title": "Reusable typed query options",
   "code": "import { queryOptions, useQuery } from '@tanstack/react-query'\n\ntype Todo = { id: number; title: string }\n\nasync function fetchTodos(): Promise<Todo[]> {\n  const response = await fetch('/api/todos')\n  if (!response.ok) throw new Error('Request failed')\n  return response.json()\n}\n\nconst todosOptions = queryOptions({\n  queryKey: ['todos'],\n  queryFn: fetchTodos,\n})\n\nexport function Todos() {\n  const { data = [] } = useQuery(todosOptions)\n  return <ul>{data.map(todo => <li key={todo.id}>{todo.title}</li>)}</ul>\n}",
   "language": "tsx",
   "explanation": "Define one typed options object and reuse it with a query hook or imperative QueryClient API."
  },
  "useCases": [
   {
    "title": "Centralize query configuration",
    "scenario": "Several components use the same resource query and should share one cache definition."
   },
   {
    "title": "Reuse options across APIs",
    "scenario": "A feature needs both a React hook and an imperative QueryClient operation."
   },
   {
    "title": "Preserve type inference",
    "scenario": "A TypeScript codebase needs query-key-based inference for fetched and selected data."
   }
  ],
  "related": [
   "useQuery",
   "QueryClient",
   "queryClient.query",
   "QueryKeyWithDataTag",
   "DefinedInitialDataOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What problem does queryOptions solve?",
    "answer": "queryOptions creates a reusable query configuration from options such as queryKey and queryFn. The returned object carries query-function data and error types through the query key, improving inference when reused.",
    "followUp": "Why is that useful beyond hooks? The same options can be passed to imperative QueryClient APIs, so one definition can coordinate declarative and imperative access."
   },
   {
    "question": "What does queryOptions accept and return?",
    "answer": "Its options parameter is a QueryOptions-shaped object, and queryKey is required. The function returns the corresponding options object with a typed query-key data tag.",
    "followUp": "What must remain consistent when reusing it? The query key and query function should describe the same resource so cache identity and inferred data remain aligned."
   },
   {
    "question": "Where can the returned options be used?",
    "answer": "A queryOptions result can generally be passed to useQuery and to imperative APIs such as queryClient.query. This makes the query definition reusable instead of duplicating its key and fetch behavior.",
    "followUp": "How would you share a parameterized query? Create a function that accepts the parameter and returns queryOptions with that parameter included in queryKey and used by queryFn."
   }
  ],
  "keyPoints": [
   "One options definition can serve both hook-based reads and imperative client operations.",
   "The API is generic over query-function data, error, selected data, and query-key types.",
   "When initialData is supplied, the resulting option type reflects defined initial data.",
   "The query key identifies the cache entry generated by the options."
  ],
  "gotchas": [
   "A queryKey must be supplied; it is not optional.",
   "The function accepts the normal useQuery option set, but the options still need to match the selected framework's API."
  ],
  "checkedAt": "2026-10-15"
 },
 "refetchInterval": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/polling",
  "sourceTitle": "Polling | TanStack Query React Docs",
  "summary": "refetchInterval makes a query poll on a timer. Use milliseconds for a fixed schedule or a callback for state-dependent polling that can stop by returning false.",
  "explanation": "Set refetchInterval to a millisecond number for continuous polling, or provide a function that receives the current Query and returns a millisecond interval. Returning false stops and clears the timer; polling operates independently of staleTime while an active observer exists.",
  "syntax": "refetchInterval: number | false | ((query: Query) => number | false)",
  "parameters": [
   {
    "name": "refetchInterval",
    "type": "number | false | ((query: Query) => number | false)",
    "description": "Polling period in milliseconds, false, or a function receiving Query and returning milliseconds or false."
   }
  ],
  "returns": "",
  "example": {
   "title": "Stop polling when a job completes",
   "code": "import { useQuery } from '@tanstack/react-query'\n\ntype Job = { status: 'running' | 'complete' }\n\nasync function fetchJob(): Promise<Job> {\n  const response = await fetch('/api/job')\n  if (!response.ok) throw new Error('Request failed')\n  return response.json()\n}\n\nexport function JobStatus() {\n  const query = useQuery({\n    queryKey: ['job'],\n    queryFn: fetchJob,\n    refetchInterval: (query) =>\n      query.state.data?.status === 'complete' ? false : 2_000,\n  })\n\n  return <p>{query.data?.status ?? 'Loading...'}</p>\n}",
   "language": "tsx",
   "explanation": "Polls the job every two seconds until the returned status is complete, then stops the timer."
  },
  "useCases": [
   {
    "title": "Fixed-interval polling",
    "scenario": "A dashboard needs periodically refreshed prices, metrics, or status data."
   },
   {
    "title": "Conditional job polling",
    "scenario": "A background job exposes a status endpoint until it reaches a terminal state."
   },
   {
    "title": "State-controlled polling",
    "scenario": "Polling should pause while a component lacks required input or is explicitly paused."
   }
  ],
  "related": [
   "refetchIntervalInBackground",
   "staleTime",
   "useQuery",
   "QueryObserver"
  ],
  "since": "",
  "interview": [
   {
    "question": "What forms can refetchInterval take?",
    "answer": "A numeric value is interpreted as a polling period in milliseconds, so the query refetches repeatedly at that frequency while it has an active observer. A function is evaluated with the current Query and must return either a millisecond period or false.",
    "followUp": "How would you stop polling after a terminal response? Return false from the callback when query.state.data indicates completion; this clears the timer."
   },
   {
    "question": "How does refetchInterval interact with staleTime?",
    "answer": "Polling uses its own schedule and is not governed by staleTime. Therefore, a query may remain fresh while refetchInterval still triggers network requests.",
    "followUp": "What should be changed if the requirement is freshness-based refetching rather than timed polling? Configure staleTime and the relevant refetch-on-event behavior instead of relying on refetchInterval."
   },
   {
    "question": "How can polling be made conditional?",
    "answer": "The callback receives the Query object, allowing the interval to depend on current query state. It can return false to pause polling or a positive millisecond value to continue it.",
    "followUp": "Can polling resume after stopping? Yes. If a later query result makes the callback return a positive interval again, polling resumes automatically."
   }
  ],
  "keyPoints": [
   "refetchInterval enables timer-driven query refetching.",
   "A numeric setting defines the period in milliseconds and operates while at least one observer is active.",
   "A callback can calculate a dynamic period from Query state or disable polling by returning false.",
   "Polling can restart automatically when the callback once again produces a positive interval.",
   "Separate timers still share deduplication for concurrent in-flight requests."
  ],
  "gotchas": [
   "A fresh query can still refetch on its polling schedule; staleTime does not disable refetchInterval.",
   "Multiple components observing the same key create separate polling timers, even though simultaneous in-flight requests are deduplicated.",
   "Return false when polling should stop; a later positive result resumes polling automatically if the query result changes."
  ],
  "checkedAt": "2026-10-15"
 },
 "replaceEqualDeep": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/replaceEqualDeep",
  "sourceTitle": "replaceEqualDeep | TanStack Query React Docs",
  "summary": "Returns the previous value when it is deeply equal to the new value; otherwise, it reuses equal nested parts from the previous value. This supports structural sharing for JSON-like data.",
  "explanation": "replaceEqualDeep compares a previous value with a new value recursively. It returns the previous value when the two are deeply equal; otherwise, it builds the new result while reusing deeply equal nested parts from the previous value, which supports structural sharing for JSON-like data.",
  "syntax": "function replaceEqualDeep<T>(a: unknown, b: T, depth?: number): T;",
  "parameters": [
   {
    "name": "a",
    "type": "unknown",
    "description": "The previous value, whose deeply equal parts are reused."
   },
   {
    "name": "b",
    "type": "T",
    "description": "The new value."
   },
   {
    "name": "depth",
    "type": "number",
    "description": "The current recursion depth. Past a depth of 500, b is returned as is."
   }
  ],
  "returns": "T — a if b is deeply equal to it, otherwise b with its deeply equal parts replaced by those of a.",
  "example": {
   "title": "Reuse unchanged nested data",
   "code": "import { replaceEqualDeep } from '@tanstack/query-core'\n\nconst previous = { user: { id: 1, name: 'Ada' }, count: 1 }\nconst next = { user: { id: 1, name: 'Ada' }, count: 2 }\n\nconst result = replaceEqualDeep(previous, next)\n\nconsole.log(result !== previous) // true\nconsole.log(result.user === previous.user) // true\nconsole.log(result.count) // 2",
   "language": "typescript",
   "explanation": "Reuses the unchanged nested user object while retaining the new count."
  },
  "useCases": [
   {
    "title": "Preserve nested identity",
    "scenario": "A query receives a freshly parsed response whose unchanged nested records should retain their old references."
   },
   {
    "title": "Minimize structural changes",
    "scenario": "A cache or state update needs a new top-level result while avoiding needless replacement of equal subtrees."
   },
   {
    "title": "Share JSON data structure",
    "scenario": "Recursive comparison of JSON-compatible query data should share unchanged branches."
   }
  ],
  "related": [
   "structural sharing",
   "query-core",
   "replaceEqualDeep"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does replaceEqualDeep do when two values differ only in some nested fields?",
    "answer": "It accepts a previous value and a new value, then returns the previous value when they are deeply equal. When they differ, unchanged deeply equal children from the previous value are reused in the returned new value.",
    "followUp": "What happens with very deeply nested input? The documented recursion depth limit means that after depth 500, the new value is returned as-is."
   },
   {
    "question": "Explain the parameters and return type.",
    "answer": "The first parameter is the previous value and may be unknown. The second parameter is the new value and determines the generic return type T; the optional third parameter represents the current recursion depth.",
    "followUp": "Why can the first parameter be unknown? The function only requires it as a source of potentially reusable deeply equal parts, while the returned shape is typed from the new value."
   },
   {
    "question": "Why is this function useful in query-data processing?",
    "answer": "It is useful for structural sharing between JSON values. Reusing unchanged references can preserve identity for unaffected subtrees and avoid treating those subtrees as changed.",
    "followUp": "What should be considered before applying it to arbitrary data? The documentation specifically describes JSON values, so non-JSON structures should not be assumed to receive equivalent handling."
   }
  ],
  "keyPoints": [
   "A completely equal new value produces the original previous reference.",
   "For partially changed data, unchanged nested children in the new value are replaced with references from the previous value.",
   "Its primary documented use is preserving shared structure across JSON-like values.",
   "Parameter a supplies the references that may be reused.",
   "Parameter b supplies the candidate result and its generic type.",
   "The optional depth parameter records where recursive comparison currently is.",
   "The return is either the old reference or a new-value-shaped result containing reused equal parts."
  ],
  "gotchas": [
   "The optional depth tracks recursion, and values deeper than 500 levels are returned without further structural sharing."
  ],
  "checkedAt": "2026-10-15"
 },
 "retry": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/query-retries",
  "sourceTitle": "Query Retries",
  "summary": "The retry option controls whether failed TanStack Query requests run again. It supports a retry count, disabling or infinite retries, and a callback for error-aware decisions.",
  "explanation": "The retry option controls whether a failed query runs again. It accepts a retry count, false to disable retries, true for unlimited retries, or a function that decides from the failure count and error; client defaults are three retries, while server defaults are zero.",
  "syntax": "retry: number | false | true | ((failureCount: number, error: TError) => boolean)",
  "parameters": [
   {
    "name": "retry",
    "type": "number | false | true | ((failureCount: number, error: TError) => boolean)",
    "description": "Maximum retry count, false to disable retries, true for infinite retries, or a predicate receiving failureCount and error."
   }
  ],
  "returns": "",
  "example": {
   "title": "Custom retry policy",
   "code": "import { useQuery } from '@tanstack/react-query'\n\nexport function Todos() {\n  const query = useQuery({\n    queryKey: ['todos'],\n    queryFn: async () => {\n      const response = await fetch('/api/todos')\n      if (!response.ok) throw new Error('Request failed')\n      return response.json()\n    },\n    retry: (failureCount, error) => {\n      if (error instanceof Error && error.message === 'Request failed') {\n        return failureCount < 2\n      }\n      return false\n    },\n  })\n\n  return <pre>{JSON.stringify(query.data ?? null)}</pre>\n}",
   "language": "tsx",
   "explanation": "The query retries only twice for this error, then exposes the final failure."
  },
  "useCases": [
   {
    "title": "Transient network recovery",
    "scenario": "A flaky network request should recover without immediately displaying an error."
   },
   {
    "title": "Error-aware retry policy",
    "scenario": "Only selected errors should be retried while permanent failures stop immediately."
   },
   {
    "title": "Client and server configuration",
    "scenario": "Different environments need different latency and resilience trade-offs."
   }
  ],
  "related": [
   "retryDelay",
   "useQuery",
   "QueryClient",
   "QueryOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What forms can the retry option take?",
    "answer": "retry may be false, true, a number, or a function receiving failureCount and error. false prevents retries, true retries indefinitely, a number limits retries, and the function returns whether another attempt is allowed.",
    "followUp": "How would you avoid retrying authentication failures? Return false from the function when the error represents an authentication failure, and retry only transient failures."
   },
   {
    "question": "What are the default retry counts?",
    "answer": "The client default is three retries, but server rendering defaults to zero. This avoids making server-side rendering wait through retry attempts unless the application explicitly opts in.",
    "followUp": "Why might a server application configure retries explicitly? It may need resilience for transient upstream failures, while accepting the added rendering latency."
   },
   {
    "question": "How should a retry callback limit attempts?",
    "answer": "The retry callback receives the current failureCount and the thrown error. Because the first retry attempt has a count of zero, a condition such as failureCount < 2 permits two retry attempts.",
    "followUp": "How can retry timing be customized? Configure retryDelay with a number or function; a function can implement linear or exponential backoff."
   }
  ],
  "keyPoints": [
   "A thrown query-function error triggers automatic retries until the configured policy stops them.",
   "Retry behavior can be set globally or overridden for a specific query.",
   "Use false when a failed request must immediately reach the error state.",
   "A numeric value sets the maximum number of retry attempts before the final error is shown.",
   "true enables unbounded retries, so it should be reserved for cases where that behavior is intentional.",
   "A callback can choose retry behavior using both the number of failures and the error."
  ],
  "gotchas": [
   "A custom retry function must account for zero-based failureCount when limiting attempts."
  ],
  "checkedAt": "2026-10-15"
 },
 "RowModel": {
  "sourceUrl": "https://tanstack.com/table/v8/docs/guide/row-models",
  "sourceTitle": "Row Models Guide",
  "summary": "RowModel is the processed table-row result used by TanStack Table. It provides hierarchical rows, flattened rows, and an ID-keyed row lookup.",
  "explanation": "RowModel describes the result produced by TanStack Table's row-model pipeline. It exposes the current rows, a flattened version including sub-rows, and an ID-keyed lookup object for efficient row access.",
  "syntax": "type RowModel<TData> = {\n  rows: Row<TData>[]\n  flatRows: Row<TData>[]\n  rowsById: Record<string, Row<TData>>\n}",
  "parameters": [],
  "returns": "An object with rows, flatRows, and rowsById collections.",
  "example": {
   "title": "Inspect a row model",
   "code": "import type { RowModel, RowData } from '@tanstack/table-core'\n\ntype Person = { name: string }\n\ndeclare const model: RowModel<Person>\n\nconst visibleRows = model.rows\nconst allRows = model.flatRows\nconst byId = model.rowsById\n\nconsole.log(visibleRows, allRows, byId)",
   "language": "typescript",
