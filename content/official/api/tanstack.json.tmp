  ],
  "checkedAt": "2026-10-15"
 },
 "staleTime": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/important-defaults",
  "sourceTitle": "Important Defaults",
  "summary": "staleTime defines how long cached query data stays fresh. Increasing it reduces stale-driven refetches; Infinity waits for manual invalidation, while 'static' prevents even that from triggering a refetch.",
  "explanation": "staleTime controls how long query data remains fresh after it is received. During that window, the cache can satisfy reads without stale-driven refetches; once it expires, normal background refetch triggers can apply. Infinity prevents staleness until manual invalidation, while 'static' also prevents manual invalidation from triggering a refetch.",
  "syntax": "staleTime: number | \"static\" | ((query: Query<TQueryFnData, TError, TQueryData, TQueryKey>) => number | \"static\")",
  "parameters": [
   {
    "name": "staleTime",
    "type": "number | \"static\" | ((query) => number | \"static\")",
    "description": "Freshness duration in milliseconds, or the special value 'static'. A function form can compute the value from the query."
   }
  ],
  "returns": "",
  "example": {
   "title": "Configure a global staleTime",
   "code": "import { QueryClient, QueryClientProvider, useQuery } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: { staleTime: 2 * 60 * 1000 },\n  },\n})\n\nfunction Todos() {\n  const { data } = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/api/todos').then((r) => r.json()),\n  })\n\n  return <pre>{JSON.stringify(data, null, 2)}</pre>\n}\n\nexport function App() {\n  return <QueryClientProvider client={queryClient}><Todos /></QueryClientProvider>\n}",
   "language": "tsx",
   "explanation": "Sets a two-minute freshness window globally, so cached todo data is reused during that period without stale-driven refetches."
  },
  "useCases": [
   {
    "title": "Reduce redundant refetches",
    "scenario": "Data changes occasionally and short-term cached reads are acceptable."
   },
   {
    "title": "Protect static reference data",
    "scenario": "Data is immutable for the lifetime of the running application."
   },
   {
    "title": "Coordinate manual refreshes",
    "scenario": "Data should remain fresh until an explicit application event invalidates it."
   }
  ],
  "related": [
   "QueryClient",
   "QueryObserverOptions",
   "refetchInterval",
   "refetchOnMount",
   "refetchOnWindowFocus",
   "refetchOnReconnect",
   "invalidateQueries"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does staleTime control?",
    "answer": "staleTime is the duration, in milliseconds, for which fetched data is treated as fresh. A longer value reduces stale-driven refetches, while the default behavior treats cached data as stale.",
    "followUp": "How would you keep boot-time reference data from refetching? Use 'static' when it cannot change during the app session; use Infinity if manual invalidation should remain effective."
   },
   {
    "question": "What is the difference between Infinity and 'static'?",
    "answer": "A query with staleTime: Infinity does not become stale automatically, so it avoids refetches caused by staleness. Manual invalidation can still invalidate it and allow a refetch.",
    "followUp": "What is the stricter alternative? staleTime: 'static', which remains non-refetching even after manual invalidation."
   },
   {
    "question": "Does staleTime prevent every refetch?",
    "answer": "staleTime is separate from refetchInterval. An interval can periodically refetch a query regardless of whether staleTime has elapsed.",
    "followUp": "Which other events can refetch stale queries? New mounts, window refocus, and network reconnection, unless their refetch options are customized."
   }
  ],
  "keyPoints": [
   "Configure staleTime either in global query defaults or on an individual query.",
   "Longer freshness windows generally reduce stale-driven refetch frequency.",
   "Data remains fresh until the configured duration passes.",
   "A two-minute staleTime lets reads use cached data without stale-driven refetches during that period.",
   "After becoming stale, a query may refetch in the background when a new instance mounts.",
   "Window refocus is another automatic background-refetch trigger for stale queries.",
   "Network reconnection can also trigger a background refetch once the query is stale."
  ],
  "gotchas": [
   "Do not choose 'static' when manual invalidation must still work; use Infinity instead.",
   "staleTime does not disable a separately configured refetchInterval."
  ],
  "checkedAt": "2026-10-15"
 },
 "useForm": {
  "sourceUrl": "https://tanstack.com/form/latest/docs/framework/react/reference/functions/useForm",
  "sourceTitle": "useForm",
  "summary": "useForm is a React hook that creates a TanStack Form instance. The returned API manages form state, submission, and fields.",
  "explanation": "In React, useForm accepts optional form options and returns an extended FormApi instance. The instance manages form state, submission, and field interaction; fields are exposed through the returned form object and can be connected to inputs with field state and handlers.",
  "syntax": "function useForm<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer, TSubmitMeta>(opts?): ReactFormExtendedApi<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer, TSubmitMeta>;",
  "parameters": [
   {
    "name": "opts",
    "type": "FormOptions<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer, TSubmitMeta>",
    "description": "Optional form configuration, including initial values, submission behavior, and validation-related options."
   }
  ],
  "returns": "ReactFormExtendedApi<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer, TSubmitMeta>",
  "example": {
   "title": "Basic React form",
   "code": "import { useForm } from '@tanstack/react-form'\n\nexport default function ProfileForm() {\n  const form = useForm({\n    defaultValues: { name: '' },\n    onSubmit: async ({ value }) => {\n      console.log(value.name)\n    },\n  })\n\n  return (\n    <form onSubmit={(event) => {\n      event.preventDefault()\n      form.handleSubmit()\n    }}>\n      <form.Field name=\"name\">\n        {(field) => (\n          <input\n            value={field.state.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n      <button type=\"submit\">Save</button>\n    </form>\n  )\n}",
   "language": "tsx",
   "explanation": "Creates a typed form instance with initial values and an asynchronous submit handler, then binds a field to an input."
  },
  "useCases": [
   {
    "title": "Form state management",
    "scenario": "Build a typed React form with controlled fields and centralized state."
   },
   {
    "title": "Submission handling",
    "scenario": "Run application logic when the user submits form values."
   },
   {
    "title": "Field integration",
    "scenario": "Connect text inputs, checkboxes, and other controls to form state."
   },
   {
    "title": "Validation",
    "scenario": "Apply synchronous or asynchronous rules to user-entered values."
   }
  ],
  "related": [
   "FormApi",
   "FormOptions",
   "ReactFormExtendedApi",
   "formOptions",
   "Field"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useForm return and what problem does it solve?",
    "answer": "useForm is a custom React Hook that returns an extended FormApi instance. That instance centralizes form-state management, submission handling, and interaction with fields.",
    "followUp": "How can configuration be shared across forms? Use formOptions to define reusable options, then spread those options into useForm while supplying form-specific behavior when needed."
   },
   {
    "question": "How is a basic submission configured?",
    "answer": "The hook accepts an options object, commonly containing defaultValues and onSubmit. The submit callback receives the current form value, allowing application code to process the submitted data.",
    "followUp": "How would you prevent a native page reload? Handle the form element's submit event, call preventDefault, and invoke the form instance's handleSubmit method."
   },
   {
    "question": "How are individual fields connected to controls?",
    "answer": "A field is created through the form instance's Field component. Its name identifies a value in the form data, while field state and handlers connect that value to a UI control.",
    "followUp": "Where does validation belong? Pass synchronous or asynchronous validator functions through a field's validators option, according to the validation event being configured."
   }
  ],
  "keyPoints": [
   "useForm returns an extended FormApi object rather than a plain state value.",
   "The returned API is the central interface for operating on the form.",
   "The hook covers state management, submission, and field interaction in one instance."
  ],
  "gotchas": [],
  "checkedAt": "2026-10-15"
 },
 "useIsFetching": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useIsFetching",
  "sourceTitle": "useIsFetching | TanStack Query React Docs",
  "summary": "useIsFetching returns how many queries are currently loading or fetching in the background. Optional query filters let you count only selected queries, making it useful for global or scoped loading indicators.",
  "explanation": "useIsFetching subscribes to the query cache and returns the current number of queries that are loading or fetching in the background. Pass query filters to narrow which queries contribute to the count, or provide a QueryClient when the nearest context is not the intended client.",
  "syntax": "function useIsFetching(filters?: QueryFilters<readonly unknown[]>, queryClient?: QueryClient): number;",
  "parameters": [
   {
    "name": "filters",
    "type": "QueryFilters<readonly unknown[]>",
    "description": "Optional QueryFilters used to narrow the matched queries. Supported filter properties include exact, fetchStatus, predicate, queryKey, stale, and type."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional explicit QueryClient. If omitted, the client from the nearest context is used."
   }
  ],
  "returns": "number — the number of queries currently loading or fetching in the background.",
  "example": {
   "title": "Global fetching indicator",
   "code": "import { useIsFetching } from '@tanstack/react-query'\n\nexport function GlobalLoadingIndicator() {\n  const isFetching = useIsFetching()\n\n  return isFetching > 0 ? (\n    <div>Queries are fetching in the background...</div>\n  ) : null\n}",
   "language": "tsx",
   "explanation": "Counts all currently fetching queries and renders a global indicator while the count is positive."
  },
  "useCases": [
   {
    "title": "Global loading indicator",
    "scenario": "Show a site-wide progress or loading element whenever any query is active in the background."
   },
   {
    "title": "Feature-scoped indicator",
    "scenario": "Display activity only while queries whose keys begin with a feature prefix are fetching."
   },
   {
    "title": "Predicate-based monitoring",
    "scenario": "Count only queries satisfying custom selection rules."
   }
  ],
  "related": [
   "QueryFilters",
   "QueryClient",
   "useIsMutating",
   "useQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useIsFetching return?",
    "answer": "It returns a number representing how many queries are currently loading or fetching in the background. A component can use whether that number is greater than zero to show a global loading indicator.",
    "followUp": "How would you limit the indicator to post queries? Pass a queryKey filter such as { queryKey: ['posts'] }; matching filters narrow the counted queries."
   },
   {
    "question": "How can the returned count be narrowed?",
    "answer": "The optional filters are QueryFilters. They can narrow matches by properties such as queryKey, exact, fetchStatus, predicate, stale, and type.",
    "followUp": "How do you require an exact key match? Set exact to true in the filter object instead of relying on prefix matching."
   },
   {
    "question": "How does useIsFetching choose its QueryClient?",
    "answer": "The hook accepts an optional QueryClient after the filters. If it is omitted, the client from the nearest context is used.",
    "followUp": "Why pass a client explicitly? It lets the component track fetching activity in a selected cache when multiple clients are available."
   }
  ],
  "keyPoints": [
   "The result is a live count, making the hook suitable for application-wide activity indicators.",
   "Use it when loading state should reflect background activity across multiple components.",
   "A queryKey filter narrows the count to queries associated with the supplied key or prefix.",
   "Set exact in the filters when prefix-style query-key matching is too broad.",
   "fetchStatus filtering lets you include only queries in a selected fetching state, such as fetching or paused.",
   "A predicate filter supports custom query-selection logic when key and status filters are insufficient."
  ],
  "gotchas": [
   "Filters are optional; without them, the count includes every matching fetching query rather than only a particular query family.",
   "When using a non-default client, pass it explicitly so the hook observes the intended cache."
  ],
  "checkedAt": "2026-10-15"
 },
 "useIsMutating": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useIsMutating",
  "sourceTitle": "useIsMutating | TanStack Query React Docs",
  "summary": "useIsMutating returns the number of currently pending mutations. Optional filters can limit the count, making it useful for application-wide loading indicators.",
  "explanation": "Call this hook to subscribe to the number of currently pending mutations. Pass mutation filters to narrow which mutations count, and optionally provide a custom QueryClient; otherwise the nearest context supplies it.",
  "syntax": "function useIsMutating(filters?: MutationFilters<unknown, Error, unknown, unknown>, queryClient?: QueryClient): number;",
  "parameters": [
   {
    "name": "filters",
    "type": "MutationFilters<unknown, Error, unknown, unknown>",
    "description": "Optional filters used to narrow the mutations included in the count; supported fields include exact, mutationKey, predicate, and status."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional client used to inspect mutations. If omitted, the nearest context provides it."
   }
  ],
  "returns": "number — the number of mutations currently pending.",
  "example": {
   "title": "Show a mutation indicator",
   "code": "import { useIsMutating } from '@tanstack/react-query'\n\nexport function PostsMutatingIndicator() {\n  const count = useIsMutating({ mutationKey: ['posts'] })\n  return count > 0 ? <span>Saving posts...</span> : null\n}",
   "language": "tsx",
   "explanation": "Counts pending mutations whose keys match the posts prefix and displays an indicator while at least one is active."
  },
  "useCases": [
   {
    "title": "Application-wide mutation status",
    "scenario": "Show a global saving or loading indicator whenever any mutation is pending."
   },
   {
    "title": "Feature-specific feedback",
    "scenario": "Display progress feedback only while mutations for a feature key are active."
   },
   {
    "title": "Custom client monitoring",
    "scenario": "Observe mutations from a separately configured QueryClient."
   }
  ],
  "related": [
   "useIsMutating",
   "useMutation",
   "useMutationState",
   "QueryClient",
   "MutationFilters"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useIsMutating return?",
    "answer": "It returns a number representing currently pending mutations, making it suitable for an app-wide loading indicator. With no filters, the count covers all pending mutations.",
    "followUp": "How would you count only post mutations? Pass a filter such as { mutationKey: ['posts'] } and use the returned number to control the indicator."
   },
   {
    "question": "How can the mutation count be narrowed?",
    "answer": "The first argument is an optional MutationFilters object. It can narrow matches by mutation key, exactness, predicate, or status.",
    "followUp": "When would exact be useful? Use exact when a key should match only that precise mutation key rather than mutations beneath its key prefix."
   },
   {
    "question": "How does useIsMutating choose a QueryClient?",
    "answer": "The optional second argument is a QueryClient. When omitted, the hook uses the QueryClient from the nearest context.",
    "followUp": "Why pass a client explicitly? This lets the hook observe mutations managed by a particular custom client instead of the contextual default."
   }
  ],
  "keyPoints": [
   "It produces a live count of pending mutations rather than a boolean.",
   "Use the count to drive global saving or loading UI.",
   "The exact filter option restricts matching to the complete mutation key.",
   "A predicate filter supports custom matching logic for mutations.",
   "The status filter can constrain matches to a selected mutation state."
  ],
  "gotchas": [
   "A mutationKey filter matches mutations using that key; without exact matching, a posts key can include mutations beneath the posts prefix.",
   "If the hook must inspect a client other than the one from the nearest context, pass that client explicitly."
  ],
  "checkedAt": "2026-10-15"
 },
 "useMutation": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useMutation",
  "sourceTitle": "useMutation | TanStack Query React Docs",
  "summary": "useMutation configures and runs server-side writes such as creating, updating, or deleting data. It returns mutation state and commands for triggering, awaiting, or resetting the operation.",
  "explanation": "useMutation creates a mutation controller for server-side writes and other effects. Configure its mutation function and lifecycle callbacks, then call mutate with one variables value; the returned result exposes status, data, errors, reset, and promise-based mutateAsync behavior.",
  "syntax": "function useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: QueryClient): UseMutationResult<TData, TError, TVariables, TOnMutateResult>;",
  "parameters": [
   {
    "name": "options",
    "type": "UseMutationOptions<TData, TError, TVariables, TOnMutateResult>",
    "description": "The mutation configuration, including the mutation function and lifecycle options."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional custom client; otherwise the client from the nearest context is used."
   }
  ],
  "returns": "UseMutationResult<TData, TError, TVariables, TOnMutateResult>",
  "example": {
   "title": "Create and refresh a todo",
   "code": "import { useMutation, useQueryClient } from '@tanstack/react-query'\n\nasync function addTodo(title: string) {\n  const response = await fetch('/api/todos', {\n    method: 'POST',\n    headers: { 'content-type': 'application/json' },\n    body: JSON.stringify({ title }),\n  })\n  if (!response.ok) throw new Error('Request failed')\n  return response.json() as Promise<{ id: string; title: string }>\n}\n\nexport function AddTodo() {\n  const queryClient = useQueryClient()\n  const mutation = useMutation({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  })\n\n  return <button onClick={() => mutation.mutate('Learn TanStack Query')}>\n    {mutation.isPending ? 'Adding…' : 'Add todo'}\n  </button>\n}",
   "language": "tsx",
   "explanation": "Defines a server-side create operation, starts it with mutate, and invalidates the todos query after success."
  },
  "useCases": [
   {
    "title": "Form submission",
    "scenario": "Submitting a form that creates or updates server data."
   },
   {
    "title": "Cache synchronization",
    "scenario": "Updating cached queries after a successful write."
   },
   {
    "title": "Optimistic updates",
    "scenario": "Showing immediate UI changes while a write is in flight and rolling them back if it fails."
   }
  ],
  "related": [
   "UseMutationOptions",
   "UseMutationResult",
   "QueryClient",
   "mutate",
   "mutateAsync",
   "MutationCache",
   "useQueryClient"
  ],
  "since": "",
  "interview": [
   {
    "question": "When would you use useMutation instead of useQuery?",
    "answer": "useMutation is intended for create, update, delete, and other server side-effects rather than fetching query data. Its options define the mutation function and lifecycle behavior, while the returned object exposes controls and state.",
    "followUp": "How should a successful write update displayed query data? Invalidate or refetch the affected queries from a lifecycle callback such as onSuccess."
   },
   {
    "question": "What is the difference between mutate and mutateAsync?",
    "answer": "mutate starts the mutation and accepts one variables argument plus optional per-call callbacks. mutateAsync provides a promise that resolves on success and throws when the mutation fails.",
    "followUp": "When is mutate preferable? Use it for event-driven actions where the component can react through mutation state or callbacks without awaiting a promise."
   },
   {
    "question": "How can mutation callbacks support optimistic updates?",
    "answer": "onMutate runs before the mutation and can return a value passed to later callbacks. That value can carry information needed to undo an optimistic update when onError runs.",
    "followUp": "What should an optimistic-update implementation do after failure? Restore the previous cached value using the onMutate result, then reconcile or invalidate the relevant query."
   }
  ],
  "keyPoints": [
   "Use the hook for writes and other server-side effects, not ordinary read operations.",
   "The React API exposes useMutation as the hook used to configure and run a mutation.",
   "The options object contains the mutation function, callbacks, retry behavior, metadata, and other mutation configuration.",
   "Pass a QueryClient as the optional second argument when the mutation must use a client other than the nearest context client."
  ],
  "gotchas": [],
  "checkedAt": "2026-10-15"
 },
 "useMutationState": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useMutationState",
  "sourceTitle": "useMutationState | TanStack Query React Docs",
  "summary": "A React hook for reading state from mutations in the MutationCache. Filter matching mutations and optionally map each one to a custom value.",
  "explanation": "useMutationState subscribes to matching entries in the MutationCache. Supply filters to choose mutations and optionally select to map each match; without a custom client, it uses the QueryClient from the nearest context, and returns the selected values as an array.",
  "syntax": "function useMutationState<TResult, TMutation>(options?: MutationStateOptions<TResult, TMutation>, queryClient?: QueryClient): TResult[];",
  "parameters": [
   {
    "name": "options?",
    "type": "MutationStateOptions<TResult, TMutation>",
    "description": "Filters mutations and optionally selects a value from each matching mutation."
   },
   {
    "name": "queryClient?",
    "type": "QueryClient",
    "description": "Uses this explicitly supplied client; otherwise the nearest context supplies the client."
   }
  ],
  "returns": "TResult[] — an array containing the selected value for each matching mutation; without select, the mutation state is returned.",
  "example": {
   "title": "Read pending mutation variables",
   "code": "import { useMutation, useMutationState } from '@tanstack/react-query'\n\nfunction PendingPosts() {\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n\n  return <>{pendingVariables.length} posts saving...</>\n}\n\nexport function Posts() {\n  const mutation = useMutation({\n    mutationKey: ['posts'],\n    mutationFn: async (titles: string[]) =>\n      fetch('/api/posts', {\n        method: 'POST',\n        body: JSON.stringify(titles),\n      }),\n  })\n\n  return <button onClick={() => mutation.mutate(['New Post'])}>Save</button>\n}",
   "language": "tsx",
   "explanation": "Reads variables from every currently pending mutation, allowing a separate component to display aggregate mutation state."
  },
  "useCases": [
   {
    "title": "Aggregate pending work",
    "scenario": "A dashboard needs to show how many mutations are currently pending across components."
   },
   {
    "title": "Cross-component mutation state",
    "scenario": "An optimistic UI needs variables or results from mutations launched by another component."
   },
   {
    "title": "Read keyed mutation results",
    "scenario": "A screen needs successful data belonging to one mutation family."
   }
  ],
  "related": [
   "MutationStateOptions",
   "MutationFilters",
   "QueryClient",
   "useMutation",
   "MutationCache"
  ],
  "since": "",
  "interview": [
   {
    "question": "What problem does useMutationState solve?",
    "answer": "It exposes all mutations in the MutationCache as an array. MutationFilters narrow the set, while select maps each matching mutation to the value returned by the hook.",
    "followUp": "How can a component observe mutations started elsewhere? Give the mutations a shared mutationKey, then filter by that key and a status such as pending."
   },
   {
    "question": "How do filters and select work together?",
    "answer": "The filters property selects which mutations are included, and select transforms each matching mutation. If select is omitted, the mutation state is returned for each match.",
    "followUp": "How would you obtain only successful results for one mutation family? Filter with both the shared mutationKey and status: 'success', then select mutation.state.data."
   },
   {
    "question": "How does the hook choose its QueryClient?",
    "answer": "The queryClient argument lets the hook use an explicitly supplied QueryClient. When omitted, the nearest context provides the client.",
    "followUp": "Why might an application pass a client explicitly? To read from a particular QueryClient rather than the one resolved from context."
   }
  ],
  "keyPoints": [
   "It observes mutation entries held by the MutationCache, including mutations initiated outside the component using the hook.",
   "Use MutationFilters such as status or mutationKey to reduce the mutations included in the result.",
   "The select callback projects every matching mutation into a value suitable for the consuming component.",
   "The result is an array containing one selected value per matching mutation.",
   "A shared mutationKey can identify a particular mutation group when reading its state."
  ],
  "gotchas": [
   "When filtering by mutationKey, the key must match the key configured on the mutation; otherwise the mutation is not selected.",
   "If a custom QueryClient is not passed, the hook resolves the client from the nearest context."
  ],
  "checkedAt": "2026-10-15"
 },
 "usePrefetchQuery": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/usePrefetchQuery",
  "sourceTitle": "usePrefetchQuery | TanStack Query React Docs",
  "summary": "usePrefetchQuery starts a query during render so a descendant behind Suspense can use the data without initiating the first fetch itself. It returns void and skips work when the query already has cached state.",
  "explanation": "usePrefetchQuery starts a query from render so data can be available before a descendant using useSuspenseQuery renders. It accepts the same query options as queryClient.query, requires a queryKey and usually a queryFn, and optionally accepts a custom QueryClient. It has no result value.",
  "syntax": "function usePrefetchQuery<TQueryFnData, TError, TData, TQueryData, TQueryKey>(options: UsePrefetchQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>, queryClient?: QueryClient): void;",
  "parameters": [
   {
    "name": "options",
    "type": "UsePrefetchQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>",
    "description": "Options for the query; these are the options accepted by queryClient.query. queryKey is required, and queryFn is required unless a default query function exists."
   },
   {
    "name": "queryClient",
    "type": "QueryClient | undefined",
    "description": "Optional custom QueryClient. If omitted, the client from the nearest context is used."
   }
  ],
  "returns": "void; the hook does not return anything.",
  "example": {
   "title": "Prefetch before Suspense",
   "code": "import { Suspense } from 'react'\nimport { usePrefetchQuery } from '@tanstack/react-query'\n\nasync function fetchPosts() {\n  const response = await fetch('/api/posts')\n  if (!response.ok) throw new Error('Request failed')\n  return response.json() as Promise<{ id: number; title: string }[]>\n}\n\nfunction App() {\n  usePrefetchQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  return (\n    <Suspense fallback={<p>Loading posts...</p>}>\n      <Posts />\n    </Suspense>\n  )\n}\n\nfunction Posts() {\n  return <div>Posts render here</div>\n}",
   "language": "tsx",
   "explanation": "Call the hook during render before a Suspense boundary containing the component that will consume the prefetched query."
  },
  "useCases": [
   {
    "title": "Start data loading before Suspense",
    "scenario": "A page renders a Suspense-wrapped child that reads data with useSuspenseQuery."
   },
   {
    "title": "Warm the query cache",
    "scenario": "A component knows the next query key and wants to populate the cache ahead of a descendant render."
   },
   {
    "title": "Prefetch through a custom client",
    "scenario": "An application has more than one QueryClient and needs this prefetch to target a specific one."
   }
  ],
  "related": [
   "useSuspenseQuery",
   "usePrefetchInfiniteQuery",
   "queryClient.query",
   "QueryClient",
   "UsePrefetchQueryOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is usePrefetchQuery used for?",
    "answer": "It initiates prefetching during render and returns void. Its intended placement is immediately before a Suspense boundary whose descendant uses useSuspenseQuery.",
    "followUp": "What happens when the query already has state? The prefetch is skipped, including when that state is pending or is an error from an earlier attempt."
   },
   {
    "question": "What arguments does the hook accept?",
    "answer": "The options argument contains everything accepted by queryClient.query. The queryKey is mandatory, and queryFn is mandatory unless a default query function is configured.",
    "followUp": "How can a different client be selected? Pass a QueryClient as the optional second argument; otherwise the nearest context client is used."
   },
   {
    "question": "What does usePrefetchQuery return?",
    "answer": "It returns nothing, so it is used for its prefetch side effect rather than for reading query data. A separate query hook reads the result after the prefetch has started or completed.",
    "followUp": "Why is calling it on every render acceptable? Cached or in-flight state causes the prefetch to be skipped instead of refetching that query."
   }
  ],
  "keyPoints": [
   "The hook's return type is void; it starts work rather than exposing query data or status.",
   "Place it in the component that renders before the Suspense boundary to reduce the time before descendant data is available.",
   "Its options mirror queryClient.query, allowing query identity and query execution behavior to be configured in one object.",
   "Every prefetch must identify the cached query with a queryKey.",
   "The optional second parameter lets the caller override the client supplied by the nearest context.",
   "Repeated render-time calls are designed to be inexpensive when the query already has cached or in-flight state."
  ],
  "gotchas": [
   "A query function is needed unless the QueryClient provides a default query function.",
   "Existing cached, pending, or error state prevents another prefetch, so the hook does not force a refetch."
  ],
  "checkedAt": "2026-10-15"
 },
 "useQueries": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useQueries",
  "sourceTitle": "useQueries | TanStack Query React Docs",
  "summary": "useQueries runs a dynamic array of TanStack Query queries in parallel. It returns the ordered query results by default, or a single derived value when combine is supplied.",
  "explanation": "useQueries accepts an options object containing a dynamically sized queries array. Each entry uses query options similar to useQuery; the hook executes them in parallel and normally returns results in input order. An optional combine function can transform those results into one value, while a second argument can provide a custom QueryClient.",
  "syntax": "function useQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;",
  "parameters": [
   {
    "name": "options",
    "type": "object",
    "description": "Options object containing the queries array and optional combine and subscribed settings."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional custom query client supplied as the hook's top-level second argument."
   }
  ],
  "returns": "TCombinedResult: without combine, an array of query results in input order; with combine, the value returned by combine.",
  "example": {
   "title": "Run a dynamic set of queries",
   "code": "import { useQueries } from '@tanstack/react-query'\n\ntype Post = { id: number; title: string }\n\nconst fetchPost = async (id: number): Promise<Post> => {\n  const response = await fetch(`/api/posts/${id}`)\n  if (!response.ok) throw new Error('Request failed')\n  return response.json()\n}\n\nexport function Posts({ ids }: { ids: number[] }) {\n  const results = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (queries) => ({\n      posts: queries.map((query) => query.data),\n      pending: queries.some((query) => query.isPending),\n    }),\n  })\n\n  return <pre>{JSON.stringify(results)}</pre>\n}",
   "language": "tsx",
   "explanation": "Creates one query for every post ID and combines their results into a single object."
  },
  "useCases": [
   {
    "title": "Dynamic parallel fetching",
    "scenario": "A screen receives a changing list of record IDs and must fetch each record without a fixed number of hook calls."
   },
   {
    "title": "Combined view state",
    "scenario": "Several independently fetched values need to be exposed as one loading/data structure."
   },
   {
    "title": "Dependent dynamic queries",
    "scenario": "A second request depends on IDs produced by an earlier request; map those IDs into the queries array when available."
   }
  ],
  "related": [
   "useQuery",
   "queryOptions",
   "QueryClient",
   "Parallel Queries",
   "Dependent Queries"
  ],
  "since": "",
  "interview": [
   {
    "question": "When would you choose useQueries over several useQuery calls?",
    "answer": "useQueries is intended for a variable number of queries. It receives an options object whose queries property is an array, allowing the array length to change without manually calling hooks in a loop.",
    "followUp": "How can the individual results be reduced to one value? Supply combine; its return value becomes the hook result instead of the default result array."
   },
   {
    "question": "What does useQueries return by default?",
    "answer": "Without combine, the hook returns query results in the same order as the input queries array. This makes each result correspond to the query configuration at the same array position.",
    "followUp": "What changes when combine is supplied? The hook returns the value produced by combine rather than the ordered array."
   },
   {
    "question": "What are two configuration differences to remember?",
    "answer": "Each queries entry is mostly like a useQuery options object, but useQueries has documented differences, including that the top-level subscribed option is not accepted per query. A custom QueryClient belongs on useQueries' second argument.",
    "followUp": "How would you support a changing list of IDs? Map the IDs to query option objects and pass that mapped array as queries."
   }
  ],
  "keyPoints": [
   "Use the hook when the number of queries is determined dynamically.",
   "Build queries as an array of objects using familiar useQuery-style options.",
   "Use combine when consumers need one derived value instead of separate query-result objects.",
   "The main options object defines the query list and may also configure combination and subscription behavior.",
   "The default result preserves positional correspondence with the supplied query configurations.",
   "A combine function changes the return type to whatever value that function produces."
  ],
  "gotchas": [
   "Do not put the top-level subscribed option inside individual query objects.",
   "Pass a custom QueryClient to useQueries itself, not separately in each query configuration.",
   "The combined result uses structural sharing, so do not assume a fresh reference is produced for every render."
  ],
  "checkedAt": "2026-10-15"
 },
 "useQueryClient": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useQueryClient",
  "sourceTitle": "useQueryClient | TanStack Query React Docs",
  "summary": "useQueryClient returns the current React QueryClient. It uses the nearest QueryClientProvider by default, or a supplied QueryClient when one is passed.",
  "explanation": "In React, useQueryClient retrieves a QueryClient from the nearest QueryClientProvider unless a client is supplied explicitly. The returned client exposes query and mutation cache operations, such as invalidating queries. Calling the hook without an explicit client requires a provider in the component tree.",
  "syntax": "function useQueryClient(queryClient?: QueryClient): QueryClient;",
  "parameters": [
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional custom client. If omitted, the client from the nearest QueryClientProvider context is used."
   }
  ],
  "returns": "The current QueryClient instance.",
  "example": {
   "title": "Invalidate posts with the current client",
   "code": "import { QueryClient, QueryClientProvider, useQueryClient } from '@tanstack/react-query'\n\nconst client = new QueryClient()\n\nfunction RefreshPosts() {\n  const queryClient = useQueryClient()\n\n  return (\n    <button onClick={() => queryClient.invalidateQueries({ queryKey: ['posts'] })}>\n      Refresh posts\n    </button>\n  )\n}\n\nexport default function App() {\n  return (\n    <QueryClientProvider client={client}>\n      <RefreshPosts />\n    </QueryClientProvider>\n  )\n}",
   "language": "tsx",
   "explanation": "The component obtains the provider's QueryClient and uses it to invalidate queries whose key begins with `posts`."
  },
  "useCases": [
   {
    "title": "Coordinate cache operations",
    "scenario": "A button or event handler needs to invalidate, refetch, or update cached queries."
   },
   {
    "title": "Target a custom client",
    "scenario": "A subtree must use a specifically selected QueryClient rather than the nearest default."
   },
   {
    "title": "Reuse the provider client",
    "scenario": "Component logic needs access to the shared query cache without constructing another client."
   }
  ],
  "related": [
   "QueryClient",
   "QueryClientProvider",
   "invalidateQueries",
   "useQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useQueryClient return, and where does it get the client?",
    "answer": "It returns the current QueryClient instance. With no argument, the hook obtains the client from the nearest QueryClientProvider; passing a QueryClient lets the component use that specific client.",
    "followUp": "What happens if neither an explicit client nor a provider is available? The hook throws because it cannot resolve a current QueryClient."
   },
   {
    "question": "When would you pass a QueryClient to useQueryClient?",
    "answer": "The optional argument is a QueryClient. It is useful when the component must operate on a custom client; otherwise, the nearest provider supplies the client.",
    "followUp": "Why might an application use more than one client? Separate clients can isolate caches, but each component must resolve the intended client rather than accidentally using the nearest default."
   },
   {
    "question": "How can the returned client be used in a component?",
    "answer": "The result can call QueryClient methods such as invalidateQueries. This lets event handlers or other component logic coordinate cached data without creating another client instance.",
    "followUp": "How would you refresh only a subset of cached data? Call invalidateQueries with a matching queryKey filter, as in `{ queryKey: ['posts'] }`."
   }
  ],
  "keyPoints": [
   "The hook gives a component access to the active QueryClient.",
   "Its signature accepts an optional QueryClient and returns a QueryClient.",
   "Pass a client when the component should target a custom cache.",
   "Without an argument, resolution starts with the nearest provider context.",
   "The return value is the resolved current client, not query data or a query result."
  ],
  "gotchas": [
   "Calling the hook without an explicit QueryClient requires a QueryClientProvider; otherwise it throws."
  ],
  "checkedAt": "2026-10-15"
 },
 "useStore": {
  "sourceUrl": "https://tanstack.com/store/latest/docs/framework/react/reference/functions/useStore-1",
  "sourceTitle": "useStore | TanStack Store React Docs",
  "summary": "useStore reads a value from a TanStack Store source, optionally selecting a slice and defining comparison behavior. In React, it is a deprecated alias for useSelector.",
  "explanation": "In TanStack Store React, useStore reads a store or derived value and optionally applies a selector to produce the value used by the component. It is a deprecated alias for useSelector, and the selected result can optionally be compared with a custom comparison function.",
  "syntax": "function useStore<TSource, TSelected>(source, selector?, compare?): TSelected;",
  "parameters": [
   {
    "name": "source",
    "type": "TSource",
    "description": "The store-like source whose snapshot is observed."
   },
   {
    "name": "selector",
    "type": "(snapshot) => TSelected",
    "description": "Optional function receiving the snapshot and returning the selected value."
   },
   {
    "name": "compare",
    "type": "(a, b) => boolean",
    "description": "Optional function comparing the previous and next selected values."
   }
  ],
  "returns": "TSelected",
  "example": {
   "title": "Read a selected store value",
   "code": "import { useStore } from '@tanstack/react-store'\n\nfunction Counter({ counterStore }) {\n  const count = useStore(counterStore, (state) => state.count)\n  return <span>{count}</span>\n}",
   "language": "tsx",
   "explanation": "Selects and renders the counter value from a TanStack Store instance."
  },
  "useCases": [
   {
    "title": "Subscribe to store state",
    "scenario": "A component needs a reactive value from a TanStack Store."
   },
   {
    "title": "Select a state slice",
    "scenario": "A component should consume only one field from a larger snapshot."
   },
   {
    "title": "Customize comparison",
    "scenario": "A selected value needs custom equality behavior."
   }
  ],
  "related": [
   "useSelector",
   "useAtom",
   "createStore"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useStore do?",
    "answer": "useStore accepts a source, an optional selector, and an optional comparison function. It returns the selected value, or the source value when no selector is supplied.",
    "followUp": "What should new code use instead? Use useSelector, because the documentation marks useStore as its deprecated alias."
   },
   {
    "question": "What are useStore's parameters?",
    "answer": "The source is the store-like object being observed, the selector maps its snapshot to the value the component needs, and compare can determine whether two selected values are equal.",
    "followUp": "Why select a smaller value? Selecting only the required slice can avoid making a component depend on unrelated state changes."
   },
   {
    "question": "What does useStore return?",
    "answer": "The hook returns TSelected. TSelected defaults to the source's type when no selector is provided, so the returned value reflects either the selected snapshot or the complete source value.",
    "followUp": "How can selection behavior be customized? Pass a selector and, when needed, a comparison function for selected values."
   }
  ],
  "keyPoints": [
   "The hook is generic over the source type and the selected result type.",
   "Its optional selector derives the value returned to the component, while compare can customize equality checks.",
   "Without an explicit selection, the selected type defaults from the source type.",
   "A selector can read only one property, such as count, from the store snapshot."
  ],
  "gotchas": [
   "useStore is deprecated; use useSelector for new code."
  ],
  "checkedAt": "2026-10-15"
 },
 "useSuspenseQueries": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useSuspenseQueries",
  "sourceTitle": "useSuspenseQueries | TanStack Query React Docs",
  "summary": "useSuspenseQueries runs multiple TanStack Query requests concurrently under React Suspense. It returns their results or an optional combined value, with each query's data guaranteed to be defined.",
  "explanation": "The hook accepts an array of query configurations and optionally a combine function. It suspends while required data loads, runs the queries in parallel, and returns a combined value or the usual query-result structure with defined data for every query.",
  "syntax": "function useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;",
  "parameters": [
   {
    "name": "options",
    "type": "object",
    "description": "Configuration object containing the queries array and optional combine function; each query follows useQueries options with the documented exclusions."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional QueryClient used by the hook."
   }
  ],
  "returns": "TCombinedResult; without combine, the result has the useQueries structure, with defined data, no isPlaceholderData, and status limited to success or error.",
  "example": {
   "title": "Parallel suspense queries",
   "code": "import { useSuspenseQueries } from '@tanstack/react-query'\n\nasync function fetchJson<T>(url: string): Promise<T> {\n  const response = await fetch(url)\n  if (!response.ok) throw new Error(`HTTP ${response.status}`)\n  return response.json() as Promise<T>\n}\n\nexport function Dashboard() {\n  const [users, teams] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: () => fetchJson<string[]>('/api/users') },\n      { queryKey: ['teams'], queryFn: () => fetchJson<string[]>('/api/teams') },\n    ],\n    combine: (results) => ({ users: results[0], teams: results[1] }),\n  })\n\n  return <p>{users.length} users in {teams.length} teams</p>\n}",
   "language": "tsx",
   "explanation": "Runs both requests through Suspense and combines their results into one value."
  },
  "useCases": [
   {
    "title": "Load independent dashboard data in parallel",
    "scenario": "A dashboard needs independent users, teams, and metrics before rendering."
   },
   {
    "title": "Avoid serial suspension",
    "scenario": "Several suspenseful queries belong to one component and should not create a waterfall."
   },
   {
    "title": "Normalize results with combine",
    "scenario": "A component wants a domain-specific object instead of an array of query results."
   }
  ],
  "related": [
   "useQueries",
   "useSuspenseQuery",
   "useSuspenseInfiniteQuery",
   "usePrefetchQuery",
   "QueryClient"
  ],
  "since": "v5",
  "interview": [
   {
    "question": "What problem does useSuspenseQueries solve?",
    "answer": "It is the Suspense-oriented multi-query hook. It receives a queries array, starts those queries in parallel, and can transform their results with combine; unlike separate suspense hooks, it avoids serial suspension.",
    "followUp": "Why not call multiple useSuspenseQuery hooks? Each can suspend before later hooks start, creating a request waterfall; useSuspenseQueries coordinates them together."
   },
   {
    "question": "Which options are unavailable?",
    "answer": "Its options follow useQueries, with two differences: top-level subscribed is unsupported, and each query cannot set throwOnError, enabled, or placeholderData. The hook's signature also accepts an optional QueryClient.",
    "followUp": "How would a component conditionally skip one query? Suspense query configuration cannot use enabled, so restructure the component or query set rather than disabling an individual entry."
   },
   {
    "question": "What does the hook return?",
    "answer": "Without combine, the return has the same overall structure as useQueries, but every query's data is guaranteed to be defined. isPlaceholderData is absent, and status is limited to success or error with corresponding derived flags.",
    "followUp": "What should handle errors? Use the surrounding Suspense and error-boundary model rather than relying on an enabled or placeholderData escape hatch."
   }
  ],
  "keyPoints": [
   "Pass query configurations in queries; combine is optional and can produce a single application-specific value.",
   "combine maps the individual query results into one returned value.",
   "Each returned query result has defined data at the type level.",
   "The result model omits loading-style uncertainty: status is success or error, with derived flags matching it.",
   "The hook does not support useQueries' top-level subscribed option."
  ],
  "gotchas": [
   "Individual queries cannot configure throwOnError, enabled, or placeholderData.",
   "The combined result uses structural sharing where possible, so do not assume a freshly allocated value on every render."
  ],
  "checkedAt": "2026-10-15"
 },
 "useSuspenseQuery": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/useSuspenseQuery",
  "sourceTitle": "useSuspenseQuery | TanStack Query React Docs",
  "summary": "useSuspenseQuery fetches query data through React Suspense instead of exposing a disabled or loading state. It returns a useQuery-like result with data guaranteed to be defined.",
  "explanation": "useSuspenseQuery is the Suspense-specific form of useQuery. It accepts query options and an optional QueryClient, suspends rendering while required data loads, and returns a result whose data is defined; loading and error handling are delegated to Suspense and error boundaries.",
  "syntax": "function useSuspenseQuery<TQueryFnData, TError, TData, TQueryKey>(options: UseSuspenseQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseSuspenseQueryResult<TData, TError>;",
  "parameters": [
   {
    "name": "options",
    "type": "UseSuspenseQueryOptions<TQueryFnData, TError, TData, TQueryKey>",
    "description": "Configuration for the query, using UseSuspenseQueryOptions; it follows useQuery options except for throwOnError, enabled, and placeholderData."
   },
   {
    "name": "queryClient",
    "type": "QueryClient",
    "description": "Optional client used to access the query cache and configuration."
   }
  ],
  "returns": "UseSuspenseQueryResult<TData, TError>: the useQuery result shape with defined data, no isPlaceholderData, and status limited to success or error.",
  "example": {
   "title": "Suspense-backed query",
   "code": "import { Suspense } from 'react'\nimport { useSuspenseQuery } from '@tanstack/react-query'\n\nfunction Todos() {\n  const { data } = useSuspenseQuery({\n    queryKey: ['todos'],\n    queryFn: async () => {\n      const response = await fetch('/api/todos')\n      if (!response.ok) throw new Error('Request failed')\n      return response.json() as Promise<{ id: number; title: string }[]>\n    },\n  })\n\n  return <ul>{data.map(todo => <li key={todo.id}>{todo.title}</li>)}</ul>\n}\n\nexport function App() {\n  return <Suspense fallback={<p>Loading…</p>}><Todos /></Suspense>\n}",
   "language": "tsx",
   "explanation": "Fetches todos while React Suspense supplies the loading boundary; the hook returns defined data when Todos renders."
  },
  "useCases": [
   {
    "title": "Suspense-driven loading",
    "scenario": "A component needs fetched data before it can render its main content."
   },
   {
    "title": "Boundary-based errors",
    "scenario": "An application uses React error boundaries for query failures."
   },
   {
    "title": "Server rendering and streaming",
    "scenario": "A TanStack Router application needs query data involved in SSR or streaming."
   }
  ],
  "related": [
   "useQuery",
   "useSuspenseInfiniteQuery",
   "useSuspenseQueries",
   "QueryClient",
   "UseSuspenseQueryOptions",
   "UseSuspenseQueryResult"
  ],
  "since": "5",
  "interview": [
   {
    "question": "Which useQuery options are unavailable?",
    "answer": "It has the same options as useQuery except throwOnError, enabled, and placeholderData. Suspense controls loading, while errors are handled through an error boundary or explicit error throwing.",
    "followUp": "How does its result differ from useQuery? Data is guaranteed to be defined, isPlaceholderData is absent, and status is success or error."
   },
   {
    "question": "How should a component handle loading?",
    "answer": "The hook suspends when data is needed, so the component should be rendered under a React Suspense boundary. The boundary supplies the fallback while the query resolves.",
    "followUp": "What happens to loading flags? The Suspense boundary replaces the component's loading-state handling rather than requiring an enabled/loading branch."
   },
   {
    "question": "What does the hook return?",
    "answer": "Its signature accepts UseSuspenseQueryOptions and an optional QueryClient, and returns UseSuspenseQueryResult. The returned data has type TData and is guaranteed to be defined.",
    "followUp": "Can the query be disabled with skipToken? No; Suspense hooks cannot represent a disabled state, so a query function must be available."
   }
  ],
  "keyPoints": [
   "Configure the hook with normal query options, excluding throwOnError, enabled, and placeholderData.",
   "Suspense and error boundaries take responsibility for loading and error presentation instead of ordinary query-state branches.",
   "After the component renders, data can be used without an undefined check.",
   "The result status is narrowed to success or error, with corresponding derived flags.",
   "A disabled query state is unsupported, so skipToken is not valid as the query function."
  ],
  "gotchas": [
   "A query function is required unless a default query function exists; skipToken cannot disable this hook.",
   "Do not depend on cancellation for an in-flight request."
  ],
  "checkedAt": "2026-10-15"
 },
 "useVirtualizer": {
  "sourceUrl": "https://tanstack.com/virtual/latest/docs/framework/react/react-virtual",
  "sourceTitle": "React Virtual | TanStack Virtual React Docs",
  "summary": "useVirtualizer creates a React Virtualizer for an HTML scroll element. It calculates the visible range for large collections while allowing the application to render and style the items.",
  "explanation": "The hook creates a Virtualizer configured for an HTML scroll element. It uses the item count and an estimated item size to calculate the scrollable range, exposes only the items near the viewport, and can refine positions through element measurement.",
  "syntax": "function useVirtualizer<TScrollElement, TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<TScrollElement, TItemElement>,\n    'observeElementRect' | 'observeElementOffset' | 'scrollToFn'\n  >,\n): Virtualizer<TScrollElement, TItemElement>",
  "parameters": [
   {
    "name": "options",
    "type": "PartialKeys<ReactVirtualizerOptions<TScrollElement, TItemElement>, 'observeElementRect' | 'observeElementOffset' | 'scrollToFn'>",
    "description": "Partial ReactVirtualizerOptions, including the item count, scroll-element getter, estimated item size, and optional adapter configuration."
   }
  ],
  "returns": "Virtualizer<TScrollElement, TItemElement>",
  "example": {
   "title": "Virtualized React list",
   "code": "import * as React from 'react'\nimport { useVirtualizer } from '@tanstack/react-virtual'\n\nexport function VirtualList() {\n  const parentRef = React.useRef<HTMLDivElement>(null)\n  const virtualizer = useVirtualizer({\n    count: 10000,\n    getScrollElement: () => parentRef.current,\n    estimateSize: () => 35,\n  })\n\n  return (\n    <div ref={parentRef} style={{ height: 400, overflow: 'auto' }}>\n      <div style={{ height: virtualizer.getTotalSize(), position: 'relative' }}>\n        {virtualizer.getVirtualItems().map(item => (\n          <div key={item.key} ref={virtualizer.measureElement}\n            data-index={item.index}\n            style={{ position: 'absolute', top: 0, transform: `translateY(${item.start}px)` }}>\n            Row {item.index}\n          </div>\n        ))}\n      </div>\n    </div>\n  )\n}",
   "language": "tsx",
   "explanation": "Creates a scrollable React list whose rendered rows are limited to the visible virtual range."
  },
  "useCases": [
   {
    "title": "Render only rows near the viewport",
    "scenario": "Large vertical lists"
   },
   {
    "title": "Start with estimates and refine positions through measurement",
    "scenario": "Variable-size content"
   },
   {
    "title": "Keep markup and styling under application control",
    "scenario": "Custom React interfaces"
   },
   {
    "title": "Choose the element-based hook or its window-based counterpart",
    "scenario": "Window or element scrolling"
   }
  ],
  "related": [
   "useWindowVirtualizer",
   "Virtualizer",
   "ReactVirtualizerOptions",
   "@tanstack/react-virtual"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does useVirtualizer return?",
    "answer": "useVirtualizer is the React adapter hook for a standard Virtualizer that uses an HTML element as its scroll element. Its options configure the item count, scroll-element lookup, sizing behavior, and other virtualization settings.",
    "followUp": "How would window scrolling differ? Use useWindowVirtualizer, which returns a Virtualizer configured with window as the scroll element."
   },
   {
    "question": "What are the main inputs to useVirtualizer?",
    "answer": "The hook takes a PartialKeys ReactVirtualizerOptions object. The adapter supplies defaults for observeElementRect, observeElementOffset, and scrollToFn, while application code provides the remaining virtualization configuration.",
    "followUp": "Why is the adapter headless? It supplies virtualization logic rather than markup or styles, so the application owns DOM structure and presentation."
   },
   {
    "question": "How does the hook support large lists?",
    "answer": "A virtualizer computes which indexes belong near the current viewport instead of requiring every item to be rendered. The item count establishes the collection size, and estimateSize gives the initial size model used to calculate the scroll range.",
    "followUp": "How can variable-height items be handled? Attach the virtualizer's measurement mechanism to rendered elements so observed sizes refine the initial estimate."
   }
  ],
  "keyPoints": [
   "useVirtualizer is the React-specific wrapper around TanStack Virtual's core virtualization engine.",
   "The hook is generic over both the scroll element type and the rendered item element type.",
   "getScrollElement supplies the current HTML element that owns scrolling.",
   "In React, useFlushSync controls whether synchronous flushSync updates are enabled and defaults to true."
  ],
  "gotchas": [
   "The scroll container must be supplied through getScrollElement; useWindowVirtualizer instead when the browser window is the scrolling surface."
  ],
  "checkedAt": "2026-10-15"
 }
}
