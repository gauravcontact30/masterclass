    "name": "queryKey",
    "type": "unknown[]",
    "description": "The array used to identify and parameterize the query."
   }
  ],
  "returns": "The page documents queryKey as an option rather than a standalone return value.",
  "example": {
   "title": "A parameterized todo-list query",
   "code": "const todosQuery = useQuery({\n  queryKey: ['todos', { status, page }],\n  queryFn: fetchTodoList,\n})\n\nasync function fetchTodoList({ queryKey }) {\n  const [, { status, page }] = queryKey\n  const response = await fetch(`/api/todos?status=${status}&page=${page}`)\n  if (!response.ok) throw new Error('Request failed')\n  return response.json()\n}",
   "language": "typescript",
