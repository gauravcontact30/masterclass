 "hydrate": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/lit/reference/functions/hydrate",
  "sourceTitle": "hydrate | TanStack Query Lit Docs",
  "summary": "Restores a dehydrated TanStack Query cache snapshot into a `QueryClient`, commonly transferring prefetched server data to the client. Existing entries are updated only when the incoming data is newer.",
  "explanation": "`hydrate` restores a dehydrated cache snapshot into a `QueryClient`. It creates missing queries, updates existing ones only when the incoming data is newer, resets newly created queries to an idle fetch status, and can resume an in-flight promise instead of invoking the query function again.",
  "syntax": "function hydrate(\n  client: QueryClient,\n  dehydratedState: Partial<DehydratedState>,\n  options?: HydrateOptions,\n): void;",
  "parameters": [
   {
    "name": "client",
    "type": "QueryClient",
    "description": "The `QueryClient` whose cache will be restored."
   },
   {
    "name": "dehydratedState",
    "type": "Partial<DehydratedState>",
    "description": "A partial dehydrated cache state, typically produced by `dehydrate`."
   },
   {
    "name": "options",
    "type": "HydrateOptions",
    "description": "Optional hydration settings, including merged defaults and data deserialization."
   }
  ],
  "returns": "void",
  "example": {
   "title": "Restore a dehydrated query cache",
   "code": "import { QueryClient, dehydrate, hydrate } from '@tanstack/query-core'\n\nconst serverClient = new QueryClient()\nawait serverClient.prefetchQuery({\n  queryKey: ['posts'],\n  queryFn: async () => [{ id: 1, title: 'Hello' }],\n})\n\nconst dehydratedState = dehydrate(serverClient)\nconst browserClient = new QueryClient()\nhydrate(browserClient, dehydratedState)",
   "language": "typescript",
   "explanation": "Prefetch data into one client, serialize its cache, then restore that state into a client used by the browser."
  },
  "useCases": [
   {
    "title": "Transfer prefetched data from server to browser",
    "scenario": "Server-rendered applications"
   },
   {
    "title": "Restore a previously serialized query cache",
    "scenario": "Persisted or serialized cache state"
   },
   {
    "title": "Deserialize data while hydrating",
    "scenario": "Custom serialization pipelines"
   }
  ],
  "related": [
   "dehydrate",
   "QueryClient",
   "DehydratedState",
   "HydrateOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is the purpose and signature of `hydrate`?",
    "answer": "`hydrate` takes a `QueryClient`, a partial `DehydratedState`, and optional `HydrateOptions`, then returns `void`. It restores the snapshot into the client's cache, commonly after server-side prefetching and dehydration.",
    "followUp": "What happens when a matching query already exists? The hydrated data is applied only if it is newer than the cached data."
   },
   {
    "question": "How does `hydrate` handle queries that are not already cached?",
    "answer": "Missing queries are built from the dehydrated snapshot. Their fetch status is reset to `idle`, preventing a newly restored query from remaining stuck in a fetching state.",
    "followUp": "How are in-flight requests handled? An in-flight dehydrated promise is resumed through `query.fetch()` and reused as the initial promise."
   },
   {
    "question": "What can `HydrateOptions` customize?",
    "answer": "`HydrateOptions` can provide defaults merged into every restored query and mutation, in addition to the client's hydration defaults. It can also provide `deserializeData` to reverse a serialization step.",
    "followUp": "Why is deserialization needed? Serialized server data must be converted back into the runtime representation expected by the client cache."
   }
  ],
  "keyPoints": [
   "Use `hydrate` to restore a cache snapshot created by `dehydrate` into a client-side `QueryClient`.",
   "Absent queries are constructed from the supplied dehydrated state.",
   "Restored queries start with an idle fetch status.",
   "Optional hydration defaults can be merged across all restored queries and mutations."
  ],
  "gotchas": [
   "Hydration does not blindly overwrite existing cache entries; freshness timestamps determine whether incoming data replaces them.",
   "An in-flight query is resumed with its existing promise rather than starting the query function again.",
   "The dehydrated input may contain queries, mutations, or either one independently."
  ],
  "checkedAt": "2026-10-15"
 },
 "HydrationBoundary": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/interfaces/HydrationBoundaryProps",
  "sourceTitle": "HydrationBoundary | TanStack Query React Docs",
  "summary": "HydrationBoundary places previously dehydrated query state into a QueryClient for a rendered subtree. It merges overlapping data by freshness and always renders its children.",
  "explanation": "HydrationBoundary accepts dehydrated query state and makes it available through the relevant QueryClient while always rendering its children. New queries are incorporated during render; existing cached queries are updated after commit only when the dehydrated data is newer.",
  "syntax": "<HydrationBoundary state={dehydratedState}>{children}</HydrationBoundary>",
  "parameters": [
   {
    "name": "__namedParameters",
    "type": "HydrationBoundaryProps",
    "description": "Props containing the dehydrated state and the children to render; the API also accepts optional hydration options and a custom QueryClient."
   }
  ],
  "returns": "Element: the supplied children, rendered unconditionally.",
  "example": {
   "title": "Hydrating prefetched server data",
   "code": "import { HydrationBoundary, dehydrate, QueryClient } from '@tanstack/react-query'\n\nexport default async function Page() {\n  const queryClient = new QueryClient()\n  await queryClient.prefetchQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  return (\n    <HydrationBoundary state={dehydrate(queryClient)}>\n      <Posts />\n    </HydrationBoundary>\n  )\n}",
   "language": "tsx",
   "explanation": "Prefetches server data, serializes the client cache, and provides it to the rendered subtree."
  },
  "useCases": [
   {
    "title": "Transfer prefetched query data from server to client",
    "scenario": "Server-rendered routes"
   },
   {
    "title": "Hydrate route data without blocking child rendering",
    "scenario": "Streaming or concurrent React applications"
   },
   {
    "title": "Apply fresher dehydrated results without overwriting newer client data",
    "scenario": "Client navigation with an existing cache"
   }
  ],
  "related": [
   "dehydrate",
   "hydrate",
   "QueryClient",
   "QueryClientProvider",
   "HydrateOptions",
   "DehydratedState"
  ],
  "since": "v5",
  "interview": [
   {
    "question": "What problem does HydrationBoundary solve?",
    "answer": "It receives a dehydrated state, typically produced with dehydrate, and hydrates that state into the query client used by the component tree. Children render unconditionally rather than waiting for hydration.",
    "followUp": "What differs for queries already cached on the client? Only newer dehydrated data is applied, and it is applied in an effect after commit rather than during render."
   },
   {
    "question": "Does HydrationBoundary hydrate mutations?",
    "answer": "It hydrates queries but not mutations. Mutation hydration requires the lower-level hydrate API or the persistQueryClient plugin.",
    "followUp": "Why might a mutation not be visible after rendering a HydrationBoundary? Because the boundary deliberately handles query state only; mutation state must be restored separately."
   },
   {
    "question": "How does hydration timing vary between new and existing queries?",
    "answer": "When a query is absent from the client cache, its dehydrated state is hydrated during render. When it already exists, only fresher dehydrated data is applied after commit.",
    "followUp": "What user-visible effect can this timing cause? A child may briefly render with the existing cache value before the fresher dehydrated value arrives."
   }
  ],
  "keyPoints": [
   "The component transfers a serialized query-cache snapshot into the QueryClient available to descendants.",
   "When cache entries overlap, freshness is decided from update timestamps instead of blindly replacing client data.",
   "Its children are always rendered; the boundary does not gate rendering on completion of hydration.",
   "Queries missing from the existing cache become available during the render phase, supporting server-rendered output.",
   "Existing entries are updated after commit only if the dehydrated snapshot is fresher than the current cache."
  ],
  "gotchas": [
   "Mutations are not hydrated by this component; use the lower-level hydrate API or a persistence plugin when mutation hydration is required.",
   "For queries already present in the cache, hydration occurs in an effect, so children can render once before fresher server data is applied."
  ],
  "checkedAt": "2026-10-15"
 },
 "InfiniteQueryObserver": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/classes/InfiniteQueryObserver",
  "sourceTitle": "InfiniteQueryObserver | TanStack Query React Docs",
  "summary": "InfiniteQueryObserver watches an infinite query and adds page-oriented state and methods to the base QueryObserver result. It is the core primitive behind framework-level infinite-query hooks.",
  "explanation": "InfiniteQueryObserver is the core observer for an infinite query. Construct it with a QueryClient and infinite-query options, subscribe to receive updated results, and use its page-fetching methods to load additional pages.",
  "syntax": "new InfiniteQueryObserver<TQueryFnData, TError, TData, TQueryKey, TPageParam>(client: QueryClient, options: InfiniteQueryObserverOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): InfiniteQueryObserver<TQueryFnData, TError, TData, TQueryKey, TPageParam>",
  "parameters": [
   {
    "name": "client",
    "type": "QueryClient",
    "description": "QueryClient used by the observer to access and manage the query cache."
   },
   {
    "name": "options",
    "type": "InfiniteQueryObserverOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>",
    "description": "Configuration for the infinite query, including its key, query function, and page-parameter behavior."
   }
  ],
  "returns": "An InfiniteQueryObserver instance; its methods expose current results, subscriptions, and infinite-page fetching.",
  "example": {
   "title": "Observe and fetch infinite-query pages",
   "code": "import { QueryClient } from '@tanstack/query-core'\nimport { InfiniteQueryObserver } from '@tanstack/query-core'\n\nconst client = new QueryClient()\nconst observer = new InfiniteQueryObserver(client, {\n  queryKey: ['posts'],\n  queryFn: async ({ pageParam }) =>\n    fetch(`/api/posts?cursor=${pageParam}`).then((r) => r.json()),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextCursor,\n})\n\nconst unsubscribe = observer.subscribe((result) => {\n  console.log(result.data?.pages)\n})\n\nawait observer.fetchNextPage()\nunsubscribe()",
   "language": "typescript",
   "explanation": "Creates an observer for cursor-based pages, listens for result updates, fetches the next page, and then unsubscribes."
  },
  "useCases": [
   {
    "title": "Create a low-level infinite-query integration",
    "scenario": "Build framework adapters or custom hooks that need direct access to infinite-query observation."
   },
   {
    "title": "Subscribe to live query results",
    "scenario": "React to cache and fetch changes without repeatedly reading snapshots."
   },
   {
    "title": "Fetch additional pages programmatically",
    "scenario": "Load cursor- or offset-based pages under application-controlled conditions."
   }
  ],
  "related": [
   "QueryObserver",
   "InfiniteQueryObserverOptions",
   "InfiniteQueryResult",
   "QueryClient",
   "useInfiniteQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What is InfiniteQueryObserver used for?",
    "answer": "It observes and switches between infinite queries while extending the normal query result with infinite-query capabilities such as page navigation. Framework adapters can build their infinite-query hooks on this primitive.",
    "followUp": "How would code react to asynchronous changes? Subscribe to the observer and process each emitted result; do not repeatedly poll a one-time result snapshot."
   },
   {
    "question": "How is an InfiniteQueryObserver configured?",
    "answer": "Construct it with a QueryClient and InfiniteQueryObserverOptions. The options define the query key, query function, initial page parameter, and how subsequent page parameters are derived.",
    "followUp": "Why is initialPageParam needed? It supplies the parameter for the first page, while later requests use values returned by the next- or previous-page parameter functions."
   },
   {
    "question": "How does it load another page and expose updates?",
    "answer": "fetchNextPage() requests the next page and returns a promise resolving to the resulting InfiniteQueryObserverResult. The result can expose infinite-query state such as whether another page exists.",
    "followUp": "What should happen after observing is no longer needed? Call the unsubscribe function returned by subscribe() to stop receiving updates."
   }
  ],
  "keyPoints": [
   "It specializes QueryObserver for infinite-query data and lets an observer change the infinite query it watches.",
   "Results add infinite-query controls and state, including page availability and page-fetching operations.",
   "Framework integrations can implement higher-level infinite-query hooks on top of this core observer.",
   "The constructor receives a QueryClient plus typed infinite-query observer options and returns the configured observer.",
   "fetchNextPage() asynchronously loads the next page and resolves with the updated observer result.",
   "The current-result accessor provides the latest computed result available at the time it is called."
  ],
  "gotchas": [
   "getCurrentResult() only returns a snapshot; use subscribe() when the code must react to later changes."
  ],
  "checkedAt": "2026-10-15"
 },
 "infiniteQueryOptions": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/infiniteQueryOptions",
  "sourceTitle": "infiniteQueryOptions | TanStack Query React Docs",
  "summary": "Build reusable, type-safe options for an infinite query. The returned query key carries the query's infinite-data and error types across TanStack Query APIs.",
  "explanation": "Use infiniteQueryOptions to package an infinite query's key and behavior once, then reuse the returned options with TanStack Query APIs. Its return type brands the query key with the query's InfiniteData and error types, improving type inference when the key is passed elsewhere.",
  "syntax": "infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\ninfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\ninfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;",
  "parameters": [
   {
    "name": "options",
    "type": "InfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>",
    "description": "Infinite-query options to preserve and brand, including the query key and infinite-query behavior."
   }
  ],
  "returns": "The supplied infinite-query options, augmented with a query key branded with InfiniteData<TQueryFnData> and TError.",
  "example": {
   "title": "Reusable infinite-query options",
   "code": "import { infiniteQueryOptions } from '@tanstack/react-query'\n\nconst feedOptions = infiniteQueryOptions({\n  queryKey: ['feed'],\n  initialPageParam: 0,\n  queryFn: ({ pageParam }) =>\n    fetch(`/api/feed?page=${pageParam}`).then((r) => r.json()),\n  getNextPageParam: (lastPage) => lastPage.nextCursor,\n})\n\n// feedOptions can be passed to useInfiniteQuery or queryClient methods.",
   "language": "typescript",
   "explanation": "This helper accepts the configuration for an infinite query and returns it with an enriched query key. That branding lets TanStack Query preserve the infinite data and error types when the options are reused across its APIs."
  },
  "useCases": [
   {
    "title": "Centralize infinite-query configuration",
    "scenario": "Several components use the same feed query."
   },
   {
    "title": "Preserve key-based type inference",
    "scenario": "A query key is passed to query-client APIs after being defined."
   },
   {
    "title": "Configure paginated loading",
    "scenario": "A screen fetches successive cursor- or offset-based pages."
   }
  ],
  "related": [
   "useInfiniteQuery",
   "InfiniteQueryOptions",
   "InfiniteData",
   "QueryKeyWithDataTag",
   "UseInfiniteQueryOptions"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does infiniteQueryOptions do?",
    "answer": "It is a type-safe builder for infinite-query configuration. The returned value brands its query key with InfiniteData and the error type, so reused keys retain useful type information across TanStack Query APIs.",
    "followUp": "Why does the helper return a branded key rather than only the input object? The branding allows APIs receiving the key to infer the corresponding infinite data and error types."
   },
   {
    "question": "What is the purpose of the options parameter and return value?",
    "answer": "The options parameter contains the infinite-query configuration, including the query key, page parameter setup, query function, and page-navigation logic. Its return value is the supplied options augmented with query-key data branding.",
    "followUp": "How would you make the options reusable? Define them once with infiniteQueryOptions, then pass the returned object to useInfiniteQuery or compatible query-client operations."
   },
   {
    "question": "How does this relate to paginated data?",
    "answer": "Infinite query data represents all fetched pages together with their page parameters. The query function receives the page parameter for the page being fetched, while getNextPageParam determines the next page parameter.",
    "followUp": "What trade-off does maxPages introduce? It bounds retained memory by removing pages, so navigation or rendering logic must tolerate pages no longer being present."
   }
  ],
  "keyPoints": [
   "The helper brands the query key so infinite-data and error types travel with it when the key is reused.",
   "Five generic type parameters describe page data, errors, selected data, the query key, and page parameters.",
   "The maxPages option limits how many pages remain in cached infinite-query data."
  ],
  "gotchas": [
   "If you configure maxPages, older pages may be removed as new pages are fetched, so code should not assume every fetched page remains stored."
  ],
  "checkedAt": "2026-10-15"
 },
 "initialData": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/guides/initial-query-data",
  "sourceTitle": "Initial Query Data",
  "summary": "`initialData` prepopulates a query's cache when no cached query exists, allowing the query to render without an initial loading state. The value persists in the cache and is stale by default unless freshness is configured.",
  "explanation": "`initialData` seeds a query's cache only when that query has not already been created or cached. It may be a value or a synchronously evaluated function, which runs once during shared query initialization. The seeded value is persisted and is stale by default; `staleTime` or `initialDataUpdatedAt` controls when TanStack Query considers it fresh.",
  "syntax": "useQuery({ queryKey, queryFn, initialData, initialDataUpdatedAt })",
  "parameters": [
   {
    "name": "initialData",
    "type": "TQueryFnData | (() => TQueryFnData | undefined) | undefined",
    "description": "Initial query data, or a function that synchronously returns it."
   },
   {
    "name": "initialDataUpdatedAt",
    "type": "number | (() => number | undefined) | undefined",
    "description": "Time in milliseconds when the initial data was last updated, or a function returning that time."
   }
  ],
  "returns": "The query result is initialized from the supplied data; when defined initial data is provided, the relevant useQuery overload exposes data as non-undefined unless select changes its type.",
  "example": {
   "title": "Seed a query with initialData",
   "code": "import { QueryClient, QueryClientProvider, useQuery } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient()\n\ntype Todo = { id: number; title: string }\n\nasync function fetchTodos(): Promise<Todo[]> {\n  return [{ id: 1, title: 'Learn TanStack Query' }]\n}\n\nfunction Todos() {\n  const query = useQuery({\n    queryKey: ['todos'],\n    queryFn: fetchTodos,\n    initialData: [{ id: 0, title: 'Initial todo' }],\n    initialDataUpdatedAt: Date.now(),\n  })\n\n  return <pre>{JSON.stringify(query.data, null, 2)}</pre>\n}\n\nexport function App() {\n  return <QueryClientProvider client={queryClient}><Todos /></QueryClientProvider>\n}",
   "language": "tsx",
   "explanation": "A query starts with cached initial data and uses a timestamp to represent when that data was last updated."
  },
  "useCases": [
   {
    "title": "Avoid an initial loading state",
    "scenario": "A server-rendered page already has the record needed by a query."
   },
   {
    "title": "Seed detail data from existing cache",
    "scenario": "A list query contains a preview of an item needed by a detail query."
   },
   {
    "title": "Preserve source freshness",
    "scenario": "Seed data came from a source with a known modification time."
   }
  ],
  "related": [
   "placeholderData",
   "staleTime",
   "queryClient.setQueryData",
   "queryClient.prefetchQuery",
   "dataUpdatedAt",
   "useQuery"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does initialData do?",
    "answer": "`initialData` populates the query cache when the query has not yet been created or cached. Unlike temporary placeholder content, it is persisted as the query's cached data.",
    "followUp": "How can cached source data be aged accurately? Pass the source query's `dataUpdatedAt` value as `initialDataUpdatedAt`, rather than inventing a freshness duration."
   },
   {
    "question": "Can initialData be a function?",
    "answer": "The option accepts either data directly or a function. A function is invoked once during shared/root query initialization and must synchronously return the initial value.",
    "followUp": "Why is the one-time behavior useful? It avoids repeatedly computing the seed during observer initialization while allowing lazy construction of the initial value."
   },
   {
    "question": "How does initialData affect refetching?",
    "answer": "Initial data is stale by default unless `staleTime` is configured. With the default zero stale time, a query can refetch immediately when it mounts.",
    "followUp": "When should `initialDataUpdatedAt` be preferred? Use it when the seed came from another query or source whose actual update timestamp is known."
   }
  ],
  "keyPoints": [
   "The option seeds the query cache with data before the query function supplies a result.",
   "Seeding applies only when the target query does not already exist in or have data in the cache.",
   "A function form is evaluated once during shared query initialization, not on every render.",
   "The function form must return its seed synchronously; it is not an asynchronous loader.",
   "The freshness timestamp is represented as a numeric JavaScript millisecond timestamp."
  ],
  "gotchas": [
   "Do not use `initialData` for placeholder, partial, or incomplete results; use `placeholderData` instead because the value is persisted.",
   "Without an appropriate freshness setting, seeded data is stale immediately and may refetch when the query mounts.",
   "Providing `initialData` does not replace the need for a query function when the enabled query must fetch."
  ],
  "checkedAt": "2026-10-15"
 },
 "keepPreviousData": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/react/reference/functions/keepPreviousData",
  "sourceTitle": "keepPreviousData | TanStack Query React Docs",
  "summary": "Keeps a query's previous result visible as placeholder data while a changed query key fetches its new result. Pass the function to placeholderData.",
  "explanation": "keepPreviousData is a generic identity function intended for a query's placeholderData option. When the query key changes, it returns the prior result so the UI can continue displaying it until the replacement data arrives.",
  "syntax": "function keepPreviousData<T>(previousData: T | undefined): T | undefined;",
  "parameters": [
   {
    "name": "previousData",
    "type": "T | undefined",
    "description": "Data associated with the previous query key, supplied by the observer; it may be undefined."
   }
  ],
  "returns": "The previous data unchanged, or undefined when no previous data is available.",
  "example": {
   "title": "Keep paginated data visible",
   "code": "import { keepPreviousData, useQuery } from '@tanstack/react-query'\n\nfunction Projects({ page }: { page: number }) {\n  const query = useQuery({\n    queryKey: ['projects', page],\n    queryFn: () => fetch(`/api/projects?page=${page}`).then(r => r.json()),\n    placeholderData: keepPreviousData,\n  })\n\n  return <pre>{JSON.stringify(query.data, null, 2)}</pre>\n}",
   "language": "tsx",
   "explanation": "Passing keepPreviousData as placeholderData preserves the prior result while the query for the changed key is fetching."
  },
  "useCases": [
   {
    "title": "Paginated results",
    "scenario": "A page number is included in queryKey and users should not see the list disappear between page requests."
   },
   {
    "title": "Key-based transitions",
    "scenario": "Filters or another key component changes and the replacement request should transition without an empty intermediate view."
   }
  ],
  "related": [
   "placeholderData",
   "useQuery",
   "QueryObserver"
  ],
  "since": "",
  "interview": [
   {
    "question": "What does keepPreviousData accept and return?",
    "answer": "keepPreviousData has the signature keepPreviousData<T>(previousData: T | undefined): T | undefined. It receives the prior query-key data from the observer and returns that value unchanged.",
    "followUp": "What happens if no prior result exists? The function returns undefined, so the query has no previous data to display."
   },
   {
    "question": "How is keepPreviousData used with a changing query key?",
    "answer": "Pass it as the query's placeholderData option. When a key changes, the previous result remains visible instead of the data becoming undefined while the new request runs.",
    "followUp": "Why is the query key still significant? A changed key still identifies and fetches distinct query data; keepPreviousData only bridges the display during the transition."
   },
   {
    "question": "What user-interface problem does this function solve?",
    "answer": "It is useful for paginated queries whose page number is part of queryKey. The old page can remain rendered until the newly requested page arrives.",
    "followUp": "How can an application distinguish transitional data? Track the query's fetching state alongside the displayed data, rather than assuming the retained result is current."
   }
  ],
  "keyPoints": [
   "Use the function directly as placeholderData, rather than invoking it yourself.",
   "A changed query key can retain the previous result during the replacement fetch.",
   "The previous query-key result is supplied to the function by the observer.",
   "The return value is the same previous data, with no transformation.",
   "Its generic signature permits any result type and also accounts for an absent previous result."
  ],
  "gotchas": [
   "It does not make the new query resolve immediately; it only supplies the previous result as placeholder data during the fetch."
  ],
  "checkedAt": "2026-10-15"
 },
 "matchQuery": {
  "sourceUrl": "https://tanstack.com/query/latest/docs/framework/vue/reference/functions/matchQuery",
  "sourceTitle": "matchQuery | TanStack Query Vue Docs",
  "summary": "Tests whether a Query satisfies the supplied QueryFilters. It returns true only when every provided filter matches.",
