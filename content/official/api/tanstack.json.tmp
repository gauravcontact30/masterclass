   },
   {
    "name": "query",
    "type": "Query<any, any, any, any>",
    "description": "The query to evaluate against the filters."
   }
  ],
  "returns": "boolean — true if the query matches every specified filter.",
  "example": {
   "title": "Check a query key",
   "code": "import { matchQuery } from '@tanstack/query-core'\n\nconst isMatch = matchQuery(\n  { queryKey: ['posts'], exact: false },\n  query,\n)\n\nconsole.log(isMatch)",
   "language": "typescript",
   "explanation": "Pass a QueryFilters object and a Query instance to test whether the query satisfies every specified filter."
  },
  "useCases": [
