{
  "name": "masterclass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test": "jest --runInBand",
    "test:db": "node scripts/test-database.mjs",
    "worker": "tsx --conditions=react-server --env-file=.env scripts/process-queue.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "images:vocabulary": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set vocabulary",
    "images:aws": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set aws",
    "images:topics": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set topics",
    "images:api": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set api",
    "official:search": "tsx --env-file-if-exists=.env scripts/generate-official-content.ts --set search",
    "official:api": "tsx --env-file-if-exists=.env scripts/generate-official-content.ts --set api",
    "official:status": "tsx scripts/generate-official-content.ts --set search --status",
    "images:workflow": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set workflow",
    "images:docs": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set docs",
    "images:lessons": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set lessons",
    "images:guides": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set guides",
    "images:courses": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set courses",
    "images:pulse": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set pulse",
    "images:blueprints": "tsx --env-file-if-exists=.env scripts/generate-card-images.ts --set blueprints",
    "landing:daily": "tsx --env-file-if-exists=.env scripts/build-landing-daily.ts",
    "landing:enrich": "tsx --env-file-if-exists=.env scripts/enrich-landing-daily.ts && tsx --env-file-if-exists=.env scripts/build-landing-daily.ts",
    "landing:words": "tsx --env-file-if-exists=.env scripts/enrich-landing-words.ts && tsx --env-file-if-exists=.env scripts/build-landing-daily.ts",
    "images:notes": "tsx --conditions=react-server --env-file-if-exists=.env scripts/generate-card-images.ts --set notes",
    "purge:legacy": "tsx --env-file=.env scripts/purge-legacy-documents.ts",
    "sonar": "sonar-scanner",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@arcjet/next": "^1.5.0",
    "@base-ui/react": "^1.8.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.117",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "inngest": "^4.21.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "simple-icons": "^16.32.0",
    "sonarqube-scanner": "^5.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
