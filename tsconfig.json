{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts",
    ".next-trial/types/**/*.ts",
    ".next-trial/dev/types/**/*.ts",
    ".next-dev2/types/**/*.ts",
    ".next-dev2/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "//": "__tests__ is excluded so a stale test file cannot break `next build`. Tests are checked by running them, and tsconfig.test.json type-checks them on demand.",
  "exclude": [
    "node_modules",
    ".scannerwork",
    ".playwright-mcp",
    "artifacts",
    "coverage",
    "__tests__",
    "scratch"
  ]
}
