/*
 * Add a board's own previous-year question paper to the Board Exams dashboard.
 *
 *   npx tsx scripts/import-board-paper.mts path/to/paper.json            check it and add it
 *   npx tsx scripts/import-board-paper.mts path/to/paper.json --check    only check it
 *   npx tsx scripts/import-board-paper.mts path/to/paper.json --replace  replace the same paper already added
 *   npx tsx scripts/import-board-paper.mts --rebuild                     rebuild the manifest from the data folder
 *
 * The file follows lib/board-exams/official-papers/types.ts (scripts/board-paper-template.json is a filled-in
 * example). A paper with any problem is refused: every question needs its answer, and every answer says whether it
 * follows the board's marking scheme or was written by us. Accepted papers go to
 * lib/board-exams/official-papers/data, and manifest.ts is rewritten so the page can load them.
 */
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { basename, join } from "node:path";
import { checkPaper, paperKey } from "../lib/board-exams/official-papers";
import type { OfficialPaper } from "../lib/board-exams/official-papers/types";

const ROOT = "lib/board-exams/official-papers";
const DATA = join(ROOT, "data");
const args = process.argv.slice(2);
const flag = (name: string) => args.includes(name);
const file = args.find(arg => !arg.startsWith("--"));

const fileName = (paper: OfficialPaper) => `${paper.board}-${paper.cls}-${paper.year}-${[...paper.subjects].sort().join("+")}.json`;
const read = (path: string) => JSON.parse(readFileSync(path, "utf8")) as OfficialPaper;

function rebuild() {
  mkdirSync(DATA, { recursive: true });
  const lines: string[] = []; const keys = new Map<string, string>();
  for (const name of readdirSync(DATA).filter(n => n.endsWith(".json")).sort()) {
    const paper = read(join(DATA, name));
    const errors = checkPaper(paper);
    if (errors.length) throw new Error(`${name} has problems:\n- ${errors.join("\n- ")}`);
    for (const subject of paper.subjects) {
      const key = paperKey(paper.board, paper.cls, subject, paper.year);
      if (keys.has(key)) throw new Error(`${name} and ${keys.get(key)} are both ${key}: keep one`);
      keys.set(key, name);
      lines.push(`  ${JSON.stringify(key)}: () => import("./data/${name}").then(m => m.default as OfficialPaper),`);
    }
  }
  writeFileSync(join(ROOT, "manifest.ts"), `// Generated by scripts/import-board-paper.mts: do not edit by hand.
// One entry per official paper in ./data, keyed \`\${board}-\${class}-\${subject}-\${year}\`.
import type { OfficialPaper } from "./types";

export const OFFICIAL_PAPERS: Record<string, () => Promise<OfficialPaper>> = {
${lines.join("\n")}${lines.length ? "\n" : ""}};
`);
  console.log(`Manifest: ${keys.size} ${keys.size === 1 ? "entry" : "entries"} from ${new Set(keys.values()).size} papers.`);
}

if (flag("--rebuild")) { rebuild(); process.exit(0); }
if (!file) { console.error("Give the paper's JSON file. See the comment at the top of this script."); process.exit(1); }

const paper = read(file);
const errors = checkPaper(paper);
if (errors.length) {
  console.error(`${basename(file)} was not added. Fix these first:\n- ${errors.join("\n- ")}`);
  process.exit(1);
}
const objective = paper.questions.filter(q => q.options).length;
const byBoard = paper.questions.filter(q => q.answerBy === "board").length;
console.log(`${basename(file)}: ${paper.board.toUpperCase()} class ${paper.cls} ${paper.year}, ${paper.paper}${paper.set ? ` (${paper.set})` : ""}`);
console.log(`  ${paper.questions.length} questions (${objective} objective), ${paper.marks} marks, ${paper.minutes} min; answers: ${byBoard} from the marking scheme, ${paper.questions.length - byBoard} written by us.`);
if (flag("--check")) process.exit(0);

const target = join(DATA, fileName(paper));
if (existsSync(target) && !flag("--replace")) { console.error(`${target} already exists. Pass --replace to overwrite it.`); process.exit(1); }
mkdirSync(DATA, { recursive: true });
writeFileSync(target, `${JSON.stringify(paper, null, 2)}\n`);
console.log(`  Saved ${target}.`);
rebuild();
